# packages/storage Environment Variables
# Copy this file to .env.development (or .env.production) and fill in the values
#
# Only needed for storage/CDN features (asset uploads)
# See developers/setup/cloudflare-r2.md for setup instructions

# =============================================================================
# R2 CDN Configuration (required for upload-assets.ts script)
# =============================================================================

# Cloudflare account ID
R2_CDN_ACCOUNT_ID=

# R2 access key credentials (create via Cloudflare dashboard)
R2_CDN_ACCESS_KEY_ID=
R2_CDN_SECRET_ACCESS_KEY=

# R2 bucket name for storing CDN assets
R2_CDN_BUCKET_NAME=

# CDN prefix path - used for both R2 upload path and CDN serving path (default: 'media')
# Assets will be uploaded to: <bucket>/<prefix>/<category>/<file>
# CDN URLs will be: CDN_DOMAIN/<prefix>/<category>/<file>
# Example: with prefix 'media', assets go to: bucket/media/brand/logo.svg
R2_CDN_PREFIX=media

# =============================================================================
# CDN Domain (optional)
# =============================================================================

# CDN domain (without prefix)
# Defaults to: https://cdn.userplane.io
# The full CDN URL is built as: CDN_DOMAIN/R2_CDN_PREFIX
CDN_DOMAIN=

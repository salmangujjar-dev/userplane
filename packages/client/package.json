{
  "name": "@userplane/client",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "clean": "git clean -xdf .cache .turbo dist node_modules"
  },
  "dependencies": {
    "@orpc/client": "^1.12.3",
    "@orpc/contract": "^1.12.3",
    "@orpc/openapi-client": "^1.12.3",
    "@userplane/contract": "*"
  },
  "devDependencies": {
    "eslint": "^9.32.0",
    "@userplane/eslint-config": "*",
    "@types/node": "^22.14.1",
    "@userplane/typescript-config": "*",
    "typescript": "5.8.2"
  }
}

{
  "name": "@userplane/db",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/migrate.ts",
    "db:reset": "bun run src/reset.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@userplane/contract": "*",
    "@userplane/common-logger": "*",
    "@userplane/payments": "*",
    "@userplane/pricing": "*",
    "better-auth": "^1.6.2",
    "drizzle-orm": "^0.45.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "@types/node": "^22.10.2",
    "@types/pg": "8.11.10",
    "@userplane/eslint-config": "*",
    "@userplane/typescript-config": "*",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.32.0",
    "typescript": "^5.5.4"
  }
}

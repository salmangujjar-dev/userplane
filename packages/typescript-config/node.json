{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Node/Bun",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ESNext"],
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "allowJs": true,
    "types": ["bun"]
  }
}

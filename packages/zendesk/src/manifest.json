{
  "name": "Userplane",
  "version": "0.2.0",
  "author": {
    "name": "Userplane",
    "email": "support@userplane.io",
    "url": "https://userplane.io"
  },
  "defaultLocale": "en",
  "private": false,
  "frameworkVersion": "2.0",
  "location": {
    "support": {
      "ticket_sidebar": {
        "url": "{{ZENDESK_IFRAME_URL}}",
        "autoLoad": true,
        "flexible": true
      },
      "new_ticket_sidebar": {
        "url": "{{ZENDESK_IFRAME_URL}}",
        "autoLoad": true,
        "flexible": true
      },
      "top_bar": {
        "url": "{{ZENDESK_IFRAME_URL}}",
        "size": {
          "width": "400px",
          "height": "500px"
        }
      },
      "ticket_editor": {
        "url": "{{ZENDESK_IFRAME_URL}}"
      }
    }
  },
  "parameters": [
    {
      "name": "jwt_secret",
      "type": "hidden",
      "secure": true,
      "scopes": ["jwt_secret_key"]
    }
  ],
  "domainWhitelist": ["{{ZENDESK_DOMAIN_WHITELIST}}"]
}

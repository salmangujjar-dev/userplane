# ===========================================
# Zendesk Manifest Configuration
# ===========================================
# These vars are injected into dist/manifest.json at package time.

# Zendesk iframe URL — dashboard page that serves the app UI
ZENDESK_IFRAME_URL='https://dash-dev.userplane.io/zendesk/iframe'

# Domain whitelist — comma-separated inside the JSON array
# Format: 'domain1", "domain2' (surrounding ["..."] is in manifest template)
ZENDESK_DOMAIN_WHITELIST='api-dev.userplane.io", "dash-dev.userplane.io'

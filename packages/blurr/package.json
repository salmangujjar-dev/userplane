{
  "name": "@userplane/blurr",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Production-grade privacy blur system for screen recording and session replay",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "tsc --watch",
    "dev:storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook dev -p 6009",
    "build": "rm -rf dist && tsc",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook dev -p 6009",
    "build-storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook build"
  },
  "keywords": [
    "privacy",
    "blur",
    "screen-recording",
    "session-replay",
    "gdpr",
    "hipaa",
    "pii",
    "data-protection"
  ],
  "dependencies": {
    "@userplane/console-logger": "workspace:*"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.3",
    "concurrently": "^9.2.1",
    "@storybook/addon-docs": "^10.1.11",
    "@storybook/html": "^10.1.11",
    "@storybook/html-vite": "^10.1.11",
    "@types/node": "^22.14.1",
    "@vitest/coverage-v8": "^4.0.16",
    "@userplane/eslint-config": "workspace:^",
    "@userplane/typescript-config": "workspace:*",
    "eslint": "^9.32.0",
    "eslint-plugin-storybook": "^10.1.11",
    "happy-dom": "^20.0.11",
    "storybook": "^10.1.11",
    "typescript": "5.8.2",
    "vite": "^6.0.11",
    "vitest": "^4.0.16"
  }
}

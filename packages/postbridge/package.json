{
  "name": "@userplane/postbridge",
  "version": "0.6.3",
  "type": "module",
  "private": true,
  "description": "Type-safe bidirectional RPC for postMessage contexts - iframes, workers, and cross-tab communication",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./bridge": {
      "types": "./src/bridge.ts",
      "import": "./src/bridge.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsc --watch",
    "dev:storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook dev -p 6007",
    "build:worker": "bun build src/bridge-worker.ts --outfile=dist/bridge-worker.bundle.js --format=esm --target=browser && cp dist/bridge-worker.bundle.js src/bridge-worker.js",
    "build": "rm -rf dist && tsc && bun run build:worker",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook dev -p 6007",
    "build-storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook build"
  },
  "dependencies": {
    "@userplane/console-logger": "workspace:*"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.3",
    "@storybook/addon-docs": "^10.1.11",
    "@storybook/react": "^10.1.11",
    "@storybook/react-vite": "^10.1.11",
    "@types/node": "^22.14.1",
    "@vitejs/plugin-react": "^4.3.1",
    "@userplane/eslint-config": "workspace:^",
    "@userplane/typescript-config": "workspace:*",
    "concurrently": "^9.2.1",
    "eslint": "^9.32.0",
    "eslint-plugin-storybook": "^10.1.11",
    "happy-dom": "^15.7.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.1.11",
    "typescript": "5.8.2",
    "vite": "^6.3.3",
    "vitest": "^2.0.5"
  }
}

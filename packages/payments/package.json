{
  "name": "@workspace/payments",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./webhooks": {
      "types": "./dist/webhooks.d.ts",
      "import": "./dist/webhooks.js",
      "default": "./dist/webhooks.js"
    },
    "./products": {
      "types": "./dist/products.d.ts",
      "import": "./dist/products.js",
      "default": "./dist/products.js"
    },
    "./state-machine": {
      "types": "./dist/state-machine.d.ts",
      "import": "./dist/state-machine.js",
      "default": "./dist/state-machine.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dodopayments/better-auth": "^1.4.2",
    "dodopayments": "^2.16.0",
    "@workspace/pricing": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9.32.0",
    "typescript": "^5.5.4"
  }
}

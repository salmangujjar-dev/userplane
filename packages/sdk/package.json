{
  "name": "@userplane/sdk",
  "version": "0.0.1",
  "type": "module",
  "private": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs.js",
    "module": "./dist/index.es.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.es.js",
        "require": "./dist/index.cjs.js"
      }
    }
  },
  "sideEffects": false,
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build",
    "build:npm": "tsc && OPTIMIZE_MODE=npm vite build",
    "build:cdn": "tsc && OPTIMIZE_MODE=cdn vite build",
    "build:npm:obfuscate": "tsc && OBFUSCATE_MODE=npm vite build",
    "build:cdn:obfuscate": "tsc && OBFUSCATE_MODE=cdn vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "preview": "vite preview",
    "prepublishOnly": "echo 'Use GitHub Actions to publish. Do not publish locally.' && exit 1",
    "storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook dev -p 6008",
    "build-storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook build"
  },
  "devDependencies": {
    "@userplane/blurr": "workspace:*",
    "@userplane/console-logger": "workspace:*",
    "@userplane/contract": "workspace:*",
    "@userplane/logger": "workspace:*",
    "@userplane/metadata": "workspace:*",
    "@userplane/postbridge": "workspace:*",
    "@chromatic-com/storybook": "^4.1.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@storybook/addon-docs": "^10.1.11",
    "@storybook/react": "^10.1.11",
    "@storybook/react-vite": "^10.1.11",
    "@types/node": "^22.14.1",
    "@userplane/eslint-config": "workspace:*",
    "@userplane/typescript-config": "workspace:*",
    "eslint": "^9.32.0",
    "eslint-plugin-storybook": "^10.1.11",
    "javascript-obfuscator": "^5.2.1",
    "nanoid": "^5.1.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remark-gfm": "^4.0.1",
    "rollup-plugin-obfuscator": "^1.1.0",
    "storybook": "^10.1.11",
    "terser": "^5.46.0",
    "typescript": "5.8.2",
    "vite": "^6.0.7",
    "vite-plugin-dts": "^4.4.0"
  }
}

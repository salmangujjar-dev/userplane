# packages/shared Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# R2 Asset Upload Configuration (required for upload-assets.ts script)
# =============================================================================

# Cloudflare account ID
R2_ASSETS_ACCOUNT_ID=

# R2 access key credentials (create via Cloudflare dashboard)
R2_ASSETS_ACCESS_KEY_ID=
R2_ASSETS_SECRET_ACCESS_KEY=

# R2 bucket name for storing assets
R2_ASSETS_BUCKET_NAME=

# Top-level path prefix for assets in R2 (default: 'media')
# Assets will be uploaded to: <bucket>/<prefix>/<category>/<file>
# Example: with prefix 'media', assets go to: bucket/media/brand/logo.svg
# R2_ASSETS_PREFIX=media

# =============================================================================
# Media CDN Configuration (optional)
# =============================================================================

# CDN base URL (without prefix)
# Defaults to: https://cdn.userplane.io
MEDIA_CDN_BASE_URL=

# Assets prefix path for serving (should match R2_ASSETS_PREFIX)
# Defaults to: media
# The full CDN URL is built as: MEDIA_CDN_BASE_URL/MEDIA_ASSETS_PREFIX
MEDIA_ASSETS_PREFIX=

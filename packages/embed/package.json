{
  "name": "@workspace/embed",
  "version": "0.0.1",
  "type": "module",
  "private": false,
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build",
    "build:cdn": "tsc && OPTIMIZE_MODE=cdn vite build",
    "upload:cdn": "bun run scripts/upload-cdn.ts",
    "deploy:cdn": "bun run build:cdn && bun run upload:cdn",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.982.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@types/node": "^22.14.1",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9.32.0",
    "terser": "^5.46.0",
    "typescript": "5.8.2",
    "vite": "^6.0.7",
    "vite-plugin-dts": "^4.4.0"
  },
  "dependencies": {
    "@workspace/console-logger": "workspace:*",
    "@workspace/sdk": "workspace:*",
    "@workspace/metadata": "workspace:*"
  }
}

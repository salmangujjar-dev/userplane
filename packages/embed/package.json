{
  "name": "@userplane/embed",
  "description": "Auto-initializing CDN embed script for the Userplane Recorder",
  "version": "0.0.1",
  "type": "module",
  "private": false,
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build",
    "build:cdn": "tsc && OPTIMIZE_MODE=cdn CDN_ENTRY=script vite build && OPTIMIZE_MODE=cdn CDN_ENTRY=main vite build",
    "upload:cdn": "bun run scripts/upload-cdn.ts",
    "deploy:cdn": "bun run build:cdn && bun run upload:cdn",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "preview": "vite preview",
    "storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook dev -p 6010",
    "build-storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook build"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.982.0",
    "@chromatic-com/storybook": "^4.1.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@storybook/addon-docs": "^10.1.11",
    "@storybook/react": "^10.1.11",
    "@storybook/react-vite": "^10.1.11",
    "@types/node": "^22.14.1",
    "@userplane/eslint-config": "*",
    "@userplane/typescript-config": "*",
    "eslint": "^9.32.0",
    "eslint-plugin-storybook": "^10.1.11",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.1.11",
    "terser": "^5.46.0",
    "typescript": "5.8.2",
    "vite": "^6.0.7",
    "vite-plugin-dts": "^4.4.0"
  },
  "dependencies": {
    "@userplane/console-logger": "*",
    "@userplane/sdk": "*",
    "@userplane/metadata": "*"
  }
}

# Embed CDN Configuration
# These credentials are used for uploading embed assets to R2 CDN
# If not set here, the upload script will try to load from apps/api/.env.<environment>
#
# Only needed when deploying embed to CDN
# See developers/setup/cloudflare-r2.md for setup instructions

# Cloudflare R2 Credentials
R2_CDN_ACCOUNT_ID=''
R2_CDN_ACCESS_KEY_ID=''
R2_CDN_SECRET_ACCESS_KEY=''
R2_CDN_BUCKET_NAME=''

# CDN Configuration
# CDN_DOMAIN + R2_CDN_PREFIX form the full CDN URL
# Example: https://cdn.userplane.io/embed
CDN_DOMAIN='https://cdn.userplane.io'
R2_CDN_PREFIX=embed

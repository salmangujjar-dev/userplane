{
  "name": "@workspace/email",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "email dev -p 3003 --dir src/emails",
    "dev:preview": "bun run dev",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "dev:all": "email dev -p 3003 --dir src/emails"
  },
  "dependencies": {
    "@react-email/components": "^1.0.4",
    "@workspace/logger": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "resend": "^4.0.1"
  },
  "devDependencies": {
    "@react-email/preview-server": "^5.2.5",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9.32.0",
    "react-email": "^5.2.5",
    "typescript": "^5.5.4"
  }
}

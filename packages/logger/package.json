{
  "name": "@userplane/logger",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "rm -rf dist && tsc",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest --coverage",
    "storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook dev -p 6011",
    "dev:storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook dev -p 6011",
    "build-storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook build"
  },
  "dependencies": {
    "@userplane/console-logger": "*"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.3",
    "@storybook/addon-docs": "^10.1.11",
    "@storybook/html": "^10.1.11",
    "@storybook/html-vite": "^10.1.11",
    "@userplane/eslint-config": "*",
    "@userplane/typescript-config": "*",
    "eslint": "^9.32.0",
    "eslint-plugin-storybook": "^10.1.11",
    "happy-dom": "^15.7.4",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.1.11",
    "typescript": "5.8.2",
    "vite": "^6.3.3",
    "vitest": "^2.0.5"
  }
}

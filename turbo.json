{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "LOG_LEVEL",
    "OBFUSCATE_MODE",
    "OPTIMIZE_MODE",
    "R2_CDN_ACCOUNT_ID",
    "R2_CDN_ACCESS_KEY_ID",
    "R2_CDN_SECRET_ACCESS_KEY",
    "R2_CDN_BUCKET_NAME",
    "R2_ASSETS_ACCOUNT_ID",
    "R2_ASSETS_ACCESS_KEY_ID",
    "R2_ASSETS_SECRET_ACCESS_KEY",
    "R2_ASSETS_BUCKET_NAME"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", ".astro/**", "dist/**"],
      "env": [
        "OBFUSCATE_MODE",
        "OPTIMIZE_MODE",
        "PORT",
        "HOST",
        "JWT_ISSUER",
        "CORS_ORIGINS",
        "CORS_CREDENTIALS",
        "CORS_MAX_AGE",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "BETTER_AUTH_COOKIE_PREFIX",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "GOOGLE_REDIRECT_URI",
        "INVITE_TOKEN_SECRET",
        "INVITE_APP_URL",
        "INVITE_TOKEN_EXPIRES_IN",
        "DOMAIN_VERIFICATION_TOKEN_EXPIRES_IN",
        "ACCESS_REQUEST_TOKEN_EXPIRES_IN",
        "WORKSPACE_CREATE_INVITE_TOKEN_EXPIRES_IN",
        "BILLING_EMAIL_VERIFICATION_TOKEN_EXPIRES_IN",
        "SESSION_TOKEN_SECRET",
        "UPLOAD_TOKEN_SECRET",
        "SESSION_TOKEN_EXPIRY",
        "UPLOAD_TOKEN_EXPIRY",
        "PRESIGNED_URL_EXPIRY",
        "DATABASE_URL",
        "RECORDER_URL",
        "RECORDER_TOKEN_SECRET",
        "RECORDER_TOKEN_EXPIRES_IN",
        "BETTER_AUTH_COOKIE_DOMAIN",
        "EMAIL_PROVIDER",
        "EMAIL_PROVIDER_API_KEY",
        "EMAIL_ONBOARDING_INBOX",
        "EMAIL_NOTIFICATION_INBOX",
        "EMAIL_BILLING_INBOX",
        "EMAIL_INVITE_INBOX",
        "EMAIL_AUTH_INBOX",
        "RATE_LIMIT_WINDOW",
        "RATE_LIMIT_MAX_REQUESTS",
        "INNGEST_SIGNING_KEY",
        "INNGEST_EVENT_KEY",
        "WORKSPACE_SWEEP_LOOKBACK_DAYS",
        "WORKSPACE_SWEEP_CRON_SCHEDULE",
        "PROJECT_SWEEP_LOOKBACK_DAYS",
        "PROJECT_SWEEP_CRON_SCHEDULE",
        "RECORDING_SWEEP_LOOKBACK_DAYS",
        "RECORDING_SWEEP_CRON_SCHEDULE",
        "WORKSPACE_RESTORATION_WINDOW_DAYS",
        "PROJECT_RESTORATION_WINDOW_DAYS",
        "RESTORATION_GRACE_PERIOD_DAYS",
        "RESTORATION_MAX_WINDOW_DAYS",
        "ASSETS_DOMAIN",
        "R2_CDN_ACCOUNT_ID",
        "R2_CDN_ACCESS_KEY_ID",
        "R2_CDN_SECRET_ACCESS_KEY",
        "R2_CDN_BUCKET_NAME",
        "R2_CDN_PREFIX",
        "R2_ASSETS_ACCOUNT_ID",
        "R2_ASSETS_ACCESS_KEY_ID",
        "R2_ASSETS_SECRET_ACCESS_KEY",
        "R2_ASSETS_BUCKET_NAME",
        "R2_REPORTS_ACCOUNT_ID",
        "R2_REPORTS_ACCESS_KEY_ID",
        "R2_REPORTS_SECRET_ACCESS_KEY",
        "R2_REPORTS_BUCKET_NAME",
        "APP_ENV",
        "CDN_DOMAIN",
        "MODE",
        "ADMIN_USER_IDS",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_AUTH_COOKIE_PREFIX",
        "NEXT_PUBLIC_HOME_URL",
        "PUBLIC_HOME_URL",
        "PUBLIC_DASH_URL",
        "PUBLIC_API_URL",
        "PUBLIC_CDN_DOMAIN",
        "NEXT_PUBLIC_CDN_DOMAIN",
        "DOCS_URL",
        "SUPPORT_EMAIL",
        "CALENDAR_URL",
        "DODO_PAYMENTS_API_KEY",
        "DODO_PAYMENTS_WEBHOOK_SECRET",
        "DODO_PAYMENTS_ENVIRONMENT",
        "DODO_PRODUCT_ESSENTIAL_MONTHLY",
        "DODO_PRODUCT_ESSENTIAL_ANNUAL",
        "DODO_PRODUCT_STARTER_MONTHLY",
        "DODO_PRODUCT_STARTER_ANNUAL",
        "DODO_PRODUCT_SCALE_UP_MONTHLY",
        "DODO_PRODUCT_SCALE_UP_ANNUAL",
        "DODO_PRODUCT_ENTERPRISE_MONTHLY",
        "DODO_PRODUCT_ENTERPRISE_ANNUAL",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "CACHE_ENABLED",
        "RATE_LIMIT_ENABLED",
        "INTERCOM_REDIRECT_URI",
        "INTERCOM_CLIENT_SECRET",
        "INTERCOM_CLIENT_ID",
        "SENTRY_DSN",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT_API",
        "SENTRY_PROJECT_DASH",
        "SENTRY_PROJECT_RECORDER",
        "SENTRY_RELEASE",
        "SENTRY_TRACES_SAMPLE_RATE",
        "NEXT_PUBLIC_SENTRY_DSN",
        "NEXT_PUBLIC_SENTRY_RELEASE",
        "NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE",
        "NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE",
        "NEXT_PUBLIC_SENTRY_REPLAYS_ERROR_SAMPLE_RATE",
        "PUBLIC_SENTRY_DSN",
        "PUBLIC_SENTRY_RELEASE",
        "PUBLIC_SENTRY_TRACES_SAMPLE_RATE",
        "PUBLIC_ASSETS_DOMAIN",
        "SKIP_IMAGE_TRANSFORM",
        "NEXT_PUBLIC_SKIP_IMAGE_TRANSFORM",
        "PUBLIC_SKIP_IMAGE_TRANSFORM",
        "CLOUDFLARE_IMAGE_ZONE",
        "NEXT_PUBLIC_CLOUDFLARE_IMAGE_ZONE",
        "PUBLIC_CLOUDFLARE_IMAGE_ZONE",
        "DEV"
      ]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "eslint.config.*"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "tsconfig.json"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}

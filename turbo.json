{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "PORT",
        "HOST",
        "JWT_ISSUER",
        "CORS_ORIGINS",
        "CORS_CREDENTIALS",
        "CORS_MAX_AGE",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "BETTER_AUTH_COOKIE_PREFIX",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "GOOGLE_REDIRECT_URI",
        "INVITE_TOKEN_SECRET",
        "APP_URL",
        "INVITE_APP_URL",
        "INVITE_TOKEN_EXPIRES_IN",
        "SESSION_TOKEN_SECRET",
        "UPLOAD_TOKEN_SECRET",
        "SESSION_TOKEN_EXPIRY",
        "UPLOAD_TOKEN_EXPIRY",
        "PRESIGNED_URL_EXPIRY",
        "DATABASE_URL",
        "RECORDER_URL",
        "RECORDER_TOKEN_SECRET",
        "RECORDER_TOKEN_EXPIRES_IN",
        "EMAIL_PROVIDER",
        "EMAIL_PROVIDER_API_KEY",
        "EMAIL_ONBOARDING_INBOX",
        "EMAIL_NOTIFICATION_INBOX",
        "EMAIL_BILLING_INBOX",
        "EMAIL_INVITE_INBOX",
        "EMAIL_AUTH_INBOX",
        "RATE_LIMIT_WINDOW",
        "RATE_LIMIT_MAX_REQUESTS",
        "TRIGGER_SECRET_KEY",
        "WORKSPACE_SWEEP_LOOKBACK_DAYS",
        "WORKSPACE_SWEEP_CRON_SCHEDULE",
        "PROJECT_SWEEP_LOOKBACK_DAYS",
        "PROJECT_SWEEP_CRON_SCHEDULE",
        "RECORDING_SWEEP_LOOKBACK_DAYS",
        "RECORDING_SWEEP_CRON_SCHEDULE",
        "WORKSPACE_RESTORATION_WINDOW_DAYS",
        "PROJECT_RESTORATION_WINDOW_DAYS",
        "RESTORATION_GRACE_PERIOD_DAYS",
        "RESTORATION_MAX_WINDOW_DAYS",
        "STORAGE_PROFILE",
        "ASSETS_DOMAIN",
        "R2_DEV_ACCOUNT_ID",
        "R2_DEV_ACCESS_KEY_ID",
        "R2_DEV_SECRET_ACCESS_KEY",
        "R2_DEV_BUCKET_NAME",
        "R2_CDN_ACCOUNT_ID",
        "R2_CDN_ACCESS_KEY_ID",
        "R2_CDN_SECRET_ACCESS_KEY",
        "R2_CDN_BUCKET_NAME",
        "R2_ASSETS_ACCOUNT_ID",
        "R2_ASSETS_ACCESS_KEY_ID",
        "R2_ASSETS_SECRET_ACCESS_KEY",
        "R2_ASSETS_BUCKET_NAME",
        "R2_REPORTS_ACCOUNT_ID",
        "R2_REPORTS_ACCESS_KEY_ID",
        "R2_REPORTS_SECRET_ACCESS_KEY",
        "R2_REPORTS_BUCKET_NAME",
        "ADMIN_USER_IDS",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_AUTH_COOKIE_PREFIX",
        "NEXT_PUBLIC_HOME_URL",
        "PUBLIC_HOME_URL",
        "PUBLIC_DASH_URL",
        "PUBLIC_API_URL"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:all": {
      "cache": false,
      "persistent": true
    }
  }
}

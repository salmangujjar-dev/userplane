{
  "info": {
    "name": "Userplane API",
    "description": "API collection for Userplane workspace and recording management platform. Uses cookie-based authentication via Better Auth.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.4.0"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3001",
      "type": "string",
      "description": "Base URL for the API server"
    },
    {
      "key": "apiVersion",
      "value": "v1",
      "type": "string",
      "description": "API version prefix"
    },
    {
      "key": "sessionToken",
      "value": "",
      "type": "string",
      "description": "Session token from Better Auth cookie (userplane.session_token)"
    },
    {
      "key": "workspaceId",
      "value": "",
      "type": "string",
      "description": "Current workspace ID"
    },
    {
      "key": "projectId",
      "value": "",
      "type": "string",
      "description": "Current project ID"
    },
    {
      "key": "inviteToken",
      "value": "",
      "type": "string",
      "description": "JWT invite token from invite URL"
    },
    {
      "key": "workspaceMemberId",
      "value": "",
      "type": "string",
      "description": "Workspace member ID for team management"
    },
    {
      "key": "domainId",
      "value": "",
      "type": "string",
      "description": "Domain ID for domain management"
    }
  ],
  "item": [
    {
      "name": "Status",
      "description": "Public status and health check endpoints (no authentication required)",
      "item": [
        {
          "name": "Get API Index",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", ""]
            },
            "description": "Get API index information including version, name, and available endpoints."
          },
          "response": []
        },
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "health"]
            },
            "description": "Check API health status with timestamp and version."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Authentication",
      "description": "Authentication endpoints managed by Better Auth. Uses cookie-based sessions with userplane.session_token cookie.",
      "item": [
        {
          "name": "Google OAuth",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/google",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "google"]
            },
            "description": "Initiate Google OAuth authentication flow. On success, sets userplane.session_token cookie."
          },
          "response": []
        },
        {
          "name": "OAuth Callback",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/callback/google",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "callback", "google"]
            },
            "description": "Google OAuth callback endpoint. Handles OAuth response and sets userplane.session_token cookie."
          },
          "response": []
        },
        {
          "name": "Get Session",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "userplane.session_token={{sessionToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/session",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "session"]
            },
            "description": "Get current user session. Requires userplane.session_token cookie."
          },
          "response": []
        },
        {
          "name": "Sign Out",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Cookie",
                "value": "userplane.session_token={{sessionToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/signout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "signout"]
            },
            "description": "Sign out current user. Clears userplane.session_token cookie."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Account",
      "description": "User account management endpoints for the authenticated user.",
      "item": [
        {
          "name": "Get Account",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "userplane.session_token={{sessionToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/account",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "account"]
            },
            "description": "Get authenticated user's account information. Returns userName and userEmail."
          },
          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"userName\": \"John Doe\",\n  \"userEmail\": \"john@example.com\"\n}"
            }
          ]
        },
        {
          "name": "Update Account",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "userplane.session_token={{sessionToken}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/account",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "account"]
            },
            "description": "Update authenticated user's account name. Returns updated userName."
          },
          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"userName\": \"John Doe\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Invite",
      "description": "Workspace invitation endpoints for validating and accepting invites.",
      "item": [
        {
          "name": "Validate Invite",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/invite?token={{inviteToken}}&action=validate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "invite"],
              "query": [
                {
                  "key": "token",
                  "value": "{{inviteToken}}",
                  "description": "JWT invite token from the invite URL"
                },
                {
                  "key": "action",
                  "value": "validate",
                  "description": "Action: 'validate' (default) or 'accept'"
                }
              ]
            },
            "description": "Validate an invite token without accepting it. No authentication required. Returns workspace info if token is valid."
          },
          "response": [
            {
              "name": "Valid Invite",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"status\": \"valid\",\n  \"workspaceId\": \"ws_123\",\n  \"workspaceName\": \"My Workspace\",\n  \"inviterName\": \"John Doe\",\n  \"inviterEmail\": \"john@example.com\"\n}"
            }
          ]
        },
        {
          "name": "Accept Invite",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "userplane.session_token={{sessionToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/invite?token={{inviteToken}}&action=accept",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "invite"],
              "query": [
                {
                  "key": "token",
                  "value": "{{inviteToken}}",
                  "description": "JWT invite token from the invite URL"
                },
                {
                  "key": "action",
                  "value": "accept",
                  "description": "Action: 'validate' (default) or 'accept'"
                }
              ]
            },
            "description": "Accept a workspace invitation using a JWT invite token. Requires authentication. Adds the user as a member of the workspace."
          },
          "response": [
            {
              "name": "Accepted",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"status\": \"accepted\",\n  \"workspaceId\": \"ws_123\",\n  \"workspaceName\": \"My Workspace\",\n  \"inviterName\": \"John Doe\",\n  \"inviterEmail\": \"john@example.com\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Workspace",
      "description": "Workspace management endpoints.",
      "item": [
        {
          "name": "Create Workspace",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "userplane.session_token={{sessionToken}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/workspace",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "workspace"]
            },
            "description": "Create a new workspace with initial project, domain, and owner membership. The URL derives the workspace name and creates the first domain."
          },
          "response": []
        },
        {
          "name": "List Workspaces",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "userplane.session_token={{sessionToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/workspace?include_notification_preference=false&include_workspace_membership=false",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "workspace"],
              "query": [
                {
                  "key": "include_notification_preference",
                  "value": "false",
                  "description": "Set to 'true' to include notification preferences for each workspace"
                },
                {
                  "key": "include_workspace_membership",
                  "value": "false",
                  "description": "Set to 'true' to include workspace membership details"
                }
              ]
            },
            "description": "Get all workspaces where the authenticated user is a member. Optionally include notification preferences and membership details."
          },
          "response": []
        },
        {
          "name": "Get Workspace by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "userplane.session_token={{sessionToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/workspace/{{workspaceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "workspace", "{{workspaceId}}"]
            },
            "description": "Get a specific workspace by ID."
          },
          "response": []
        },
        {
          "name": "Delete Workspace",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Cookie",
                "value": "userplane.session_token={{sessionToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/workspace/{{workspaceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "workspace", "{{workspaceId}}"]
            },
            "description": "Delete a workspace. Requires admin or owner role."
          },
          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"message\": \"Workspace deleted successfully\",\n  \"workspaceId\": \"ws_123\"\n}"
            }
          ]
        },
        {
          "name": "Get Workspace Preferences",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "userplane.session_token={{sessionToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/workspace/{{workspaceId}}/preferences",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "workspace", "{{workspaceId}}", "preferences"]
            },
            "description": "Get workspace recording preferences including branding and capture settings."
          },
          "response": []
        },
        {
          "name": "Update Workspace Preferences",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "userplane.session_token={{sessionToken}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recordingCustomizeLink\": true,\n  \"recordingHideSensitive\": false,\n  \"recordingCaptureClientLog\": true,\n  \"recordingCaptureServerLog\": true,\n  \"recordingCompanyName\": \"My Company\",\n  \"recordingHeader\": \"Welcome to our recording\",\n  \"recordingFootnote\": null,\n  \"recordingPrimaryColor\": \"#0066CC\",\n  \"recordingMaxDuration\": 3600\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/workspace/{{workspaceId}}/preferences",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "workspace", "{{workspaceId}}", "preferences"]
            },
            "description": "Update workspace recording preferences. All fields are optional. Requires workspace membership."
          },
          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"workspaceId\": \"ws_123\",\n  \"message\": \"Workspace preferences updated successfully\"\n}"
            }
          ]
        },
        {
          "name": "Upload Company Logo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Cookie",
                "value": "userplane.session_token={{sessionToken}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "logo",
                  "type": "file",
                  "description": "PNG file (max 4MB)"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/workspace/{{workspaceId}}/preferences/recordingCompanyLogo",
              "host": ["{{baseUrl}}"],
              "path": [
                "api",
                "{{apiVersion}}",
                "workspace",
                "{{workspaceId}}",
                "preferences",
                "recordingCompanyLogo"
              ]
            },
            "description": "Upload a company logo for the workspace. Only PNG files up to 4MB are allowed."
          },
          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"workspaceId\": \"ws_123\",\n  \"path\": \"/uploads/workspaces/ws_123/logos/logo.png\",\n  \"message\": \"Company logo uploaded successfully\"\n}"
            }
          ]
        },
        {
          "name": "Leave Workspace",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Cookie",
                "value": "userplane.session_token={{sessionToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/workspace/{{workspaceId}}/leave",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "workspace", "{{workspaceId}}", "leave"]
            },
            "description": "Leave a workspace (self-removal). Cannot leave if you are the last owner."
          },
          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"workspaceId\": \"ws_123\",\n  \"message\": \"Successfully left workspace\"\n}"
            }
          ]
        },
        {
          "name": "Update Notification Preferences",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "userplane.session_token={{sessionToken}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notifyOnLinkUsage\": true,\n  \"notifyOnQuotaReset\": false,\n  \"notifyOnQuotaLimit\": true,\n  \"notifyOnInviteAccepted\": true,\n  \"notifyOnMemberJoin\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/workspace/{{workspaceId}}/notifications",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "workspace", "{{workspaceId}}", "notifications"]
            },
            "description": "Update notification preferences for the authenticated user in the workspace. All fields are optional booleans."
          },
          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"workspaceId\": \"ws_123\",\n  \"message\": \"Notification preferences updated successfully\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Workspace Members",
      "description": "Member management endpoints within a workspace.",
      "item": [
        {
          "name": "Get Members",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "userplane.session_token={{sessionToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/workspace/{{workspaceId}}/members?page=1&include_me=false",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "workspace", "{{workspaceId}}", "members"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number for pagination (default: 1)"
                },
                {
                  "key": "include_me",
                  "value": "false",
                  "description": "Include requesting user's membership info (default: false)"
                }
              ]
            },
            "description": "Get workspace members with pagination. Returns members sorted by role."
          },
          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"workspaceId\": \"ws_123\",\n  \"workspaceMembers\": [\n    {\n      \"workspaceMemberId\": \"wm_123\",\n      \"memberName\": \"John Doe\",\n      \"memberEmail\": \"john@example.com\",\n      \"workspaceRole\": \"owner\"\n    },\n    {\n      \"workspaceMemberId\": \"wm_456\",\n      \"memberName\": \"Jane Smith\",\n      \"memberEmail\": \"jane@example.com\",\n      \"workspaceRole\": \"member\"\n    }\n  ],\n  \"pagination\": {\n    \"page\": 1,\n    \"perPage\": 5,\n    \"total\": 2,\n    \"totalPages\": 1\n  }\n}"
            },
            {
              "name": "With include_me",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"workspaceId\": \"ws_123\",\n  \"workspaceMembers\": [...],\n  \"workspaceMembership\": {\n    \"workspaceMemberId\": \"wm_123\",\n    \"workspaceRole\": \"owner\"\n  },\n  \"pagination\": {\n    \"page\": 1,\n    \"perPage\": 5,\n    \"total\": 2,\n    \"totalPages\": 1\n  }\n}"
            }
          ]
        },
        {
          "name": "Update Member Role",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Cookie",
                "value": "userplane.session_token={{sessionToken}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/workspace/{{workspaceId}}/members/{{workspaceMemberId}}",
              "host": ["{{baseUrl}}"],
              "path": [
                "api",
                "{{apiVersion}}",
                "workspace",
                "{{workspaceId}}",
                "members",
                "{{workspaceMemberId}}"
              ]
            },
            "description": "Update a member's role. Valid roles: 'owner', 'admin', 'member'. Requires admin or owner role."
          },
          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"workspaceId\": \"ws_123\",\n  \"workspaceMemberId\": \"wm_456\",\n  \"message\": \"Member role updated successfully\"\n}"
            }
          ]
        },
        {
          "name": "Remove Member",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Cookie",
                "value": "userplane.session_token={{sessionToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/workspace/{{workspaceId}}/members/{{workspaceMemberId}}",
              "host": ["{{baseUrl}}"],
              "path": [
                "api",
                "{{apiVersion}}",
                "workspace",
                "{{workspaceId}}",
                "members",
                "{{workspaceMemberId}}"
              ]
            },
            "description": "Remove a member from the workspace (soft delete). Cannot remove the last owner. Requires admin or owner role."
          },
          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"workspaceId\": \"ws_123\",\n  \"workspaceMemberId\": \"wm_456\",\n  \"message\": \"Member removed successfully\"\n}"
            }
          ]
        }
      ]
    },
    {
      "name": "Workspace Invite",
      "description": "Workspace invitation management endpoints. Invite tokens are JWT with 30-day expiration.",
      "item": [
        {
          "name": "Get Invite URL",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "userplane.session_token={{sessionToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/workspace/{{workspaceId}}/invite",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "workspace", "{{workspaceId}}", "invite"]
            },
            "description": "Get the current workspace invite URL with JWT token (valid for 30 days). Available to all workspace members."
          },
          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"inviteUrl\": \"https://app.userplane.io/invite?token=eyJ...\",\n  \"workspaceId\": \"ws_123\"\n}"
            }
          ]
        },
        {
          "name": "Rotate Invite Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Cookie",
                "value": "userplane.session_token={{sessionToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/workspace/{{workspaceId}}/invite/rotate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "{{apiVersion}}", "workspace", "{{workspaceId}}", "invite", "rotate"]
            },
            "description": "Rotate the workspace invite token, generating a new JWT and invalidating all previous invite links. Returns new invite URL valid for 30 days. Requires admin or owner role."
          },
          "response": [
            {
              "name": "Success",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "body": "{\n  \"inviteUrl\": \"https://app.userplane.io/invite?token=eyJ...\",\n  \"workspaceId\": \"ws_123\"\n}"
            }
          ]
        },
        {
          "name": "Send Invites by Email",
          "request": {
            "method": "POST",
            "header": [

---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Y Combinator Startup Directory - Discover over 5,000 companies backed by YC"
    />
    <!-- <meta name="userplane:workspace" content="ws_playground" /> -->
    <link rel="icon" type="image/png" href="/yc-logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto+Slab:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script>
      import * as userplane from '@workspace/sdk';
      import { getFlagsMetadata, getUserMetadata } from '../flags/utils';

      // Initialize the Userplane SDK with the workspace ID
      userplane.initialize({
        workspaceId: 'ws_jUcnqdGX3hAD',
      });

      // Set the metadata for the Userplane SDK
      userplane.metadata(() => ({
        flags: getFlagsMetadata(),
        user: getUserMetadata(),
      }));
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>

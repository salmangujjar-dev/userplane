---
interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

const defaultDescription =
  'Y Combinator Startup Directory - Discover over 5,000 companies backed by YC';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description || defaultDescription} />
    <meta name="userplane:blur" content=".company-location" />
    <meta name="userplane:blur" content=".company-description" />
    <meta name="userplane:blur" content=".search-input" />
    <link rel="icon" type="image/png" href="/yc-logo.png" />
    <!-- Set the workspace ID for the playground -->
    <meta name="userplane:workspace" content="ws_riP5gYg0fLYz" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <!-- Try to import the SDK as an ES module for the playground -->
    <!-- <script>
      import * as userplane from '@workspace/sdk';

      // Initialize the Userplane SDK once
      userplane.initialize({
        workspaceId: ['ws_UqPERwvxiO5U'],
      });
    </script> -->
    <!-- Try the embed script for production use -->
    <script src="https://dev.userplane.io/embed/script.js?v=2.2.1"></script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>

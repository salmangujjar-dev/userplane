---
interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

const defaultDescription =
  'Y Combinator Startup Directory - Discover over 5,000 companies backed by YC';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description || defaultDescription} />
    <meta name="userplane:blur" content=".company-location" />
    <meta name="userplane:blur" content=".company-description" />
    <meta name="userplane:blur" content=".search-input" />
    <link rel="icon" type="image/png" href="/yc-logo.png" />
    <!-- Set the workspace ID for the playground -->
    <meta name="userplane:workspace" content="ws_riP5gYg0fLYz" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <!-- Toast container for notifications -->
    <div id="toast-container" class="toast-container"></div>
    <!-- Try to import the SDK as an ES module for the playground -->
    <!-- <script>
      import * as userplane from '@workspace/sdk';

      // Initialize the Userplane SDK once
      userplane.initialize({
        workspaceId: ['ws_UqPERwvxiO5U'],
      });
    </script> -->
    <!-- Try the embed script for production use -->
    <script src="https://cdn-dev.userplane.io/embed/script.js"></script>
    <script>
      import Intercom from '@intercom/messenger-js-sdk';

      // Fetch JWT from server-side API for secure Intercom authentication
      async function initializeIntercom() {
        try {
          const response = await fetch('/api/intercom-jwt');
          const data = await response.json();

          if (data.token) {
            // Initialize Intercom with JWT authentication
            Intercom({
              app_id: 'z5rq51gl',
              api_base: 'https://api-iam.intercom.io',
              user_hash: data.token,
              session_duration: 86400000, // 1 day in ms
              alignment: 'left',
              horizontal_padding: 20,
              vertical_padding: 20,
            });
          } else {
            console.error('Failed to get Intercom JWT:', data.error);
            // Fallback: Initialize without JWT
            Intercom({
              app_id: 'z5rq51gl',
              alignment: 'left',
              horizontal_padding: 20,
              vertical_padding: 20,
            });
          }
        } catch (error) {
          console.error('Error initializing Intercom:', error);
          // Fallback: Initialize without JWT
          Intercom({
            app_id: 'z5rq51gl',
            alignment: 'left',
            horizontal_padding: 20,
            vertical_padding: 20,
          });
        }
      }

      // Initialize Intercom when the page loads
      initializeIntercom();
    </script>
    <script>
      // Intercept apply buttons that have the data-apply-blocked attribute
      // and show an error toast instead of navigating.
      function showToast(title: string, description: string) {
        const container = document.getElementById('toast-container');
        if (!container) return;

        const toast = document.createElement('div');
        toast.className = 'toast';
        toast.innerHTML = `
          <svg class="toast-icon" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a.75.75 0 000 1.5h.253a.25.25 0 01.244.304l-.459 2.066A1.75 1.75 0 0010.747 15H11a.75.75 0 000-1.5h-.253a.25.25 0 01-.244-.304l.459-2.066A1.75 1.75 0 009.253 9H9z" clip-rule="evenodd" />
          </svg>
          <div class="toast-body">
            <div class="toast-title">${title}</div>
            <div class="toast-description">${description}</div>
          </div>
          <div class="toast-close" role="button" aria-label="Dismiss">
            <svg viewBox="0 0 16 16" fill="currentColor" width="14" height="14">
              <path d="M3.72 3.72a.75.75 0 011.06 0L8 6.94l3.22-3.22a.75.75 0 111.06 1.06L9.06 8l3.22 3.22a.75.75 0 11-1.06 1.06L8 9.06l-3.22 3.22a.75.75 0 01-1.06-1.06L6.94 8 3.72 4.78a.75.75 0 010-1.06z" />
            </svg>
          </div>
        `;

        // Dismiss on close button click
        const closeBtn = toast.querySelector('.toast-close');
        closeBtn?.addEventListener('click', () => dismissToast(toast));

        container.appendChild(toast);

        // Auto-dismiss after 5 seconds
        setTimeout(() => dismissToast(toast), 5000);
      }

      function dismissToast(toast: HTMLElement) {
        if (toast.classList.contains('toast-exit')) return;
        toast.classList.add('toast-exit');
        toast.addEventListener('animationend', () => toast.remove());
      }

      // Attach listeners to all blocked apply buttons
      document.querySelectorAll('[data-apply-blocked]').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          showToast(
            'Unable to submit application',
            'Something went wrong. Please try again later.'
          );
        });
      });
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>

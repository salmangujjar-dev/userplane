# Server Configuration
# Port is pinned via SHARE_PORT env var and in src/env/index.ts (default: 3002)
SHARE_PORT=3002
SHARE_HOST=0.0.0.0
NODE_ENV=development

# CORS Configuration
# Use * for public access or specify allowed origins
SHARE_CORS_ORIGINS=*
SHARE_CORS_CREDENTIALS=false
SHARE_CORS_MAX_AGE=86400

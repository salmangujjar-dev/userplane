# Dashboard App Configuration (Next.js)
# Copy this file to .env.local and fill in the values

# ==========================================
# Server Configuration
# ==========================================
# Port is pinned in package.json dev script: next dev -p 3000
# PORT=3000

# ==========================================
# API Configuration (Required)
# ==========================================
# The API server URL - where your Hono API is running
NEXT_PUBLIC_API_URL=http://localhost:3001

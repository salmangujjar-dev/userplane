# Dashboard App Configuration (Next.js)
# Copy this file to .env.local and fill in the values

# ==========================================
# Server Configuration
# ==========================================
# Port is pinned in package.json dev script: next dev -p 3000
# PORT=3000

# ==========================================
# Application Environment
# ==========================================
# APP_ENV controls deployment-stage behavior (cookie security, Sentry sampling, etc.)
# Separate from NODE_ENV which controls Node.js runtime optimizations
#
# Values: development | production
# - development: Development via Cloudflare tunnels (HTTPS)
# - production: Production server
#
# Note: APP_ENV is typically set via the dev script (e.g., APP_ENV=development next dev)
# rather than in this file.
# APP_ENV=development

# ==========================================
# Home/Marketing Configuration (Required)
# ==========================================
# The Home/Marketing site URL - where your marketing site is running
NEXT_PUBLIC_HOME_URL='https://home-dev.userplane.io'

# ==========================================
# API Configuration (Required)
# ==========================================
# The API server URL - where your Hono API is running
NEXT_PUBLIC_API_URL='https://api-dev.userplane.io'

# ==========================================
# App URLs
# ==========================================
# Dashboard URL
NEXT_PUBLIC_DASHBOARD_URL='https://dash-dev.userplane.io'

# Recorder URL
NEXT_PUBLIC_RECORDER_URL='https://recorder-dev.userplane.io'

# ==========================================
# Authentication Configuration
# ==========================================
# Cookie prefix used by better-auth (must match API configuration)
# Default: userplane
NEXT_PUBLIC_AUTH_COOKIE_PREFIX='userplane'

# ==========================================
# CDN Configuration
# ==========================================
# CDN domain for media assets (logos, favicons, etc.)
NEXT_PUBLIC_CDN_DOMAIN='https://cdn.userplane.io'

# Cloudflare zone for image transforms (e.g., 'userplane.io')
# Used to optimize images on-the-fly via Cloudflare's /cdn-cgi/image/ endpoint
NEXT_PUBLIC_CLOUDFLARE_IMAGE_ZONE='userplane.io'

# Set to 'true' to disable image transforms (serve original URLs)
# Useful for debugging or when Cloudflare transforms are not available
# NEXT_PUBLIC_SKIP_IMAGE_TRANSFORM=true

# ==========================================
# Sentry Configuration
# ==========================================
# Sentry is used for error tracking, performance monitoring, and session replay.
# Get these values from your Sentry project settings.

# ============================================
# Runtime Configuration (Required at runtime)
# ============================================
# These variables are read when the application runs in browser/server

# Client-side Sentry DSN (Public, safe to expose in browser)
# Format: https://<key>@<organization>.ingest.sentry.io/<project-id>
NEXT_PUBLIC_SENTRY_DSN=''

# Release identifier for source map association and deployment tracking
# Typically set to git commit SHA or version number (e.g., "1.0.0" or git hash)
NEXT_PUBLIC_SENTRY_RELEASE=''

# Client-side performance monitoring sample rate (0.0 to 1.0)
# Default: 1.0 in development, 0.1 in production
# Lower values reduce quota usage
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=''

# Session replay sample rate for normal sessions (0.0 to 1.0)
# Default: 0.1 (captures 10% of normal sessions)
NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=''

# Session replay sample rate for sessions with errors (0.0 to 1.0)
# Default: 1.0 (captures 100% of sessions with errors)
NEXT_PUBLIC_SENTRY_REPLAYS_ERROR_SAMPLE_RATE=''

# Server-side Sentry DSN (Private, keep secure)
# Can be the same as NEXT_PUBLIC_SENTRY_DSN or different for server errors
SENTRY_DSN=''

# Server-side release identifier
# Should match NEXT_PUBLIC_SENTRY_RELEASE for consistency
SENTRY_RELEASE=''

# Server-side performance monitoring sample rate (0.0 to 1.0)
# Default: 1.0 in development, 0.1 in production
SENTRY_TRACES_SAMPLE_RATE=''

# ============================================
# Build-time Configuration (Optional)
# ============================================
# These are ONLY needed during build for uploading source maps to Sentry.
# They are NOT used at runtime. Can be set in CI/CD environment.
# Should NOT be committed to version control.

# Sentry organization slug (found in Sentry organization settings)
SENTRY_ORG='userplane-dev'

# Sentry project slug for the dashboard app
SENTRY_PROJECT_DASH='userplane-dash'

# Sentry authentication token with source map upload permissions
# Create at: https://sentry.io/settings/account/api/auth-tokens/
# Required scopes: project:releases, project:write
SENTRY_AUTH_TOKEN=''

# ===========================================
# Zendesk App Configuration
# ===========================================
# Copy this to .env.development or .env.production and fill in values.
#
# VITE_* — Bundled into the app at build time via Vite (import.meta.env).
#          Controls which API and dashboard the iframe talks to at runtime.
#
# ZENDESK_DOMAIN_WHITELIST — Injected into dist/package/manifest.json at build time.
#          Controls which domains the Zendesk proxy can reach.

# --- Runtime URLs (bundled into JS) ---
VITE_API_BASE_URL='https://api-dev.userplane.io'
VITE_DASHBOARD_URL='https://dash-dev.userplane.io'

# --- Domain whitelist (injected into manifest.json) ---
# Comma-separated inside the JSON array: 'domain1", "domain2'
ZENDESK_DOMAIN_WHITELIST='api-dev.userplane.io", "dash-dev.userplane.io'

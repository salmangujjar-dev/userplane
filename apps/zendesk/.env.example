# ===========================================
# Zendesk App Configuration
# ===========================================
# Copy this to .env.development or .env.production and fill in values.
#
# There are two categories of vars here:
#
# VITE_* — Bundled into the app at build time via Vite (import.meta.env).
#          Controls which API and dashboard the iframe talks to at runtime.
#
# ZENDESK_APP_OAUTH_* — Injected into dist/manifest.json at build time
#          by scripts/inject-manifest-env.sh. These are the credentials
#          for the "inbound" OAuth flow where Userplane is the PROVIDER
#          and the Zendesk app authenticates with us.
#          Must match ZENDESK_APP_OAUTH_* in apps/api/.env.{development,production}.

# --- Runtime URLs (bundled into JS) ---
VITE_API_BASE_URL='https://api-dev.userplane.io'
VITE_DASHBOARD_URL='https://dash-dev.userplane.io'

# --- Inbound App OAuth (injected into manifest.json) ---
# client_id and client_secret go into the manifest "oauth" block.
# Zendesk stores the secret server-side and uses it for token exchange.
# Generate a secret: openssl rand -hex 32
ZENDESK_APP_OAUTH_CLIENT_ID=''
ZENDESK_APP_OAUTH_CLIENT_SECRET=''

# --- Domain whitelist (injected into manifest.json) ---
# Domains the Zendesk secure proxy is allowed to reach.
# Format: comma-separated inside the JSON array, e.g. 'api-dev.userplane.io", "dash-dev.userplane.io'
# (the surrounding ["..."] is already in manifest.json — this value fills the middle)
ZENDESK_DOMAIN_WHITELIST='api-dev.userplane.io", "dash-dev.userplane.io'

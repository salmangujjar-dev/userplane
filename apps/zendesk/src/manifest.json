{
  "name": "Userplane",
  "version": "0.1.0",
  "author": {
    "name": "Userplane",
    "email": "support@userplane.io",
    "url": "https://userplane.io"
  },
  "defaultLocale": "en",
  "private": true,
  "frameworkVersion": "2.0",
  "location": {
    "support": {
      "ticket_sidebar": {
        "url": "assets/index.html",
        "autoLoad": true,
        "flexible": true
      },
      "new_ticket_sidebar": {
        "url": "assets/index.html",
        "autoLoad": true,
        "flexible": true
      },
      "top_bar": {
        "url": "assets/index.html",
        "size": {
          "width": "400px",
          "height": "500px"
        }
      }
    }
  },
  "oauth": {
    "client_id": "{{ZENDESK_APP_OAUTH_CLIENT_ID}}",
    "client_secret": "{{ZENDESK_APP_OAUTH_CLIENT_SECRET}}",
    "authorize_uri": "{{VITE_DASHBOARD_URL}}/oauth/zendesk/authorize",
    "access_token_uri": "{{VITE_API_BASE_URL}}/api/v1/oauth/token",
    "scope": "zendesk:read zendesk:write"
  },
  "parameters": [
    {
      "name": "access_token",
      "type": "oauth"
    }
  ],
  "domainWhitelist": ["{{ZENDESK_DOMAIN_WHITELIST}}"]
}

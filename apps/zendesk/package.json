{
  "name": "@userplane/zendesk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc && vite build",
    "build:dev": "rm -rf dist && tsc && vite build --mode development",
    "start": "zcli apps:server dist",
    "package": "zcli apps:package dist",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6012",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@userplane/contract": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.1.11",
    "@storybook/addon-docs": "^10.1.11",
    "@storybook/react": "^10.1.11",
    "@storybook/react-vite": "^10.1.11",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@userplane/eslint-config": "*",
    "@userplane/typescript-config": "workspace:*",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.32.0",
    "storybook": "^10.1.11",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-static-copy": "^2.2.0"
  }
}

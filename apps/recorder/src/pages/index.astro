---
import '../styles/global.css';
import { ButtonDemo } from '@/components/ButtonDemo';
import { getAppMeta } from '@workspace/meta';

const meta = getAppMeta('recorder');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={meta.favicon} />
    <meta name="generator" content={Astro.generator} />

    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <meta name="keywords" content={meta.keywords} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:locale" content={meta.locale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
  </head>

  <body class="min-h-screen bg-background">
    <main class="container mx-auto py-8">
      <div class="flex flex-col items-center justify-center min-h-screen gap-8">
        <div class="text-center">
          <h1 class="text-4xl font-bold mb-2">Astro + React + shadcn/ui</h1>
          <p class="text-muted-foreground">A simple counter example</p>
        </div>

        <ButtonDemo client:load />
      </div>
    </main>
  </body>
</html>

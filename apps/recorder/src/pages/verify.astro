---
import '../styles/global.css';
import VerificationApp from '@/components/verification/VerificationApp';
import { getAppMeta } from '@workspace/meta';

const meta = getAppMeta('recorder');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={meta.favicon} />
    <meta name="generator" content={Astro.generator} />

    <title>Verify Domain - {meta.title}</title>
    <meta name="description" content="Verify domain ownership for Userplane" />
    <meta name="keywords" content={meta.keywords} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content="Verify Domain" />
    <meta property="og:description" content="Verify domain ownership for Userplane" />
    <meta property="og:locale" content={meta.locale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Verify Domain" />
    <meta name="twitter:description" content="Verify domain ownership for Userplane" />
  </head>

  <body class="min-h-screen bg-background">
    <VerificationApp client:load />
  </body>
</html>

# Recorder App Configuration (Astro)
# Copy this file to .env and fill in the values

# ==========================================
# Server Configuration
# ==========================================
# Port is pinned in astro.config.mjs and package.json: --port 4322
# PORT=4322

# ==========================================
# Home/Marketing Configuration (Required)
# ==========================================
# The Home/Marketing site URL - where your marketing site is running
PUBLIC_HOME_URL=http://localhost:4321

# ==========================================
# API Configuration (Required)
# ==========================================
# The API server URL - where your Hono API is running
PUBLIC_API_URL=http://localhost:3001

# Recorder App Configuration (Astro)
# Copy this file to .env and fill in the values

# ==========================================
# Application Environment
# ==========================================
# For Astro apps, the deployment stage is controlled via the --mode CLI flag
# (e.g., astro dev --mode preview) which sets import.meta.env.MODE
#
# Values: development | production
# - development: Development via Cloudflare tunnels (default)
# - production: Production server
#
# No APP_ENV variable needed in this file for Astro apps

# ==========================================
# API Configuration
# ==========================================
# API Base URL (must include the /api/v1 path)
# In production, this should point to your API server
PUBLIC_API_URL=https://api-dev.userplane.io/api/v1

# ==========================================
# CDN Configuration
# ==========================================
# CDN domain for media assets (logos, favicons, etc.)
PUBLIC_CDN_DOMAIN=https://cdn.userplane.io

# Assets domain for user-uploaded content (thumbnails, etc.)
PUBLIC_ASSETS_DOMAIN=https://assets.userplane.io

# Cloudflare zone for image transforms (e.g., 'userplane.io')
# Used to optimize images on-the-fly via Cloudflare's /cdn-cgi/image/ endpoint
PUBLIC_CLOUDFLARE_IMAGE_ZONE=userplane.io

# Set to 'true' to disable image transforms (serve original URLs)
# Useful for debugging or when Cloudflare transforms are not available
# PUBLIC_SKIP_IMAGE_TRANSFORM=true

# ============================================================================
# PostHog Configuration
# ============================================================================
# PostHog is used for error tracking and session replay.

# ============================================
# Runtime Configuration (Required at runtime)
# ============================================
# These variables are read when the application runs in the browser

# PostHog project API key
PUBLIC_POSTHOG_KEY=

# PostHog API host
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ============================================
# Build-time Configuration (Optional)
# ============================================
# These are ONLY needed during build for uploading source maps to PostHog.
# They are NOT used at runtime. Can be set in CI/CD environment.
# Should NOT be committed to version control.

# PostHog personal API key for source map uploads
POSTHOG_PERSONAL_API_KEY=

# PostHog project ID for source map uploads
POSTHOG_PROJECT_ID=

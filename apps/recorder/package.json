{
  "name": "recorder",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev --port 4322",
    "dev:astro": "astro dev --port 4322",
    "dev:storybook": "storybook dev -p 6006",
    "build": "astro build && if [ -n \"$POSTHOG_PERSONAL_API_KEY\" ] && [ -n \"$POSTHOG_PROJECT_ID\" ]; then POSTHOG_CLI_TOKEN=$POSTHOG_PERSONAL_API_KEY POSTHOG_CLI_ENV_ID=$POSTHOG_PROJECT_ID posthog-cli sourcemap inject --directory ./dist && POSTHOG_CLI_TOKEN=$POSTHOG_PERSONAL_API_KEY POSTHOG_CLI_ENV_ID=$POSTHOG_PROJECT_ID posthog-cli sourcemap upload --directory ./dist; else echo 'Skipping source map upload (POSTHOG_PERSONAL_API_KEY or POSTHOG_PROJECT_ID not set)'; fi",
    "preview": "astro preview --port 4322",
    "astro": "astro",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "astro check",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.11",
    "@astrojs/react": "^4.4.2",
    "posthog-js": "^1.205.2",
    "@tailwindcss/vite": "^4.1.16",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@workspace/client": "workspace:*",
    "@workspace/contract": "workspace:*",
    "@workspace/shared": "workspace:*",
    "@workspace/storage": "workspace:*",
    "@workspace/logger": "workspace:*",
    "@workspace/postbridge": "workspace:*",
    "@workspace/ui": "workspace:*",
    "astro": "^5.15.9",
    "canvas-confetti": "^1.9.3",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.16",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "@chromatic-com/storybook": "^4.1.3",
    "@storybook/addon-a11y": "^10.1.11",
    "@storybook/addon-docs": "^10.1.11",
    "@storybook/addon-onboarding": "^10.1.11",
    "@storybook/addon-vitest": "^10.1.11",
    "@storybook/react": "^10.1.11",
    "@storybook/react-vite": "^10.1.11",
    "@vitest/browser-playwright": "^4.0.16",
    "@vitest/coverage-v8": "^4.0.16",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "@posthog/cli": "^0.5.29",
    "concurrently": "^9.2.1",
    "eslint": "^9.32.0",
    "eslint-plugin-storybook": "^10.1.11",
    "playwright": "^1.57.0",
    "storybook": "^10.1.11",
    "tw-animate-css": "^1.3.6",
    "vitest": "^4.0.16"
  }
}

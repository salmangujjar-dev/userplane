{
  "name": "recorder",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "prepare:worker": "bun build ../../packages/postbridge/src/bridge-worker.ts --outfile=public/bridge-worker.js --format=esm --target=browser && cp public/bridge-worker.js ../../packages/postbridge/src/bridge-worker.js",
    "prebuild": "bun run prepare:worker",
    "dev": "bun run prepare:worker && next dev --turbopack -p 4322",
    "build": "next build",
    "start": "next start -p 4322",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "dev:storybook": "storybook dev -p 6006",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@userplane/client": "*",
    "@userplane/contract": "*",
    "@userplane/shared": "*",
    "@userplane/storage": "*",
    "@userplane/common-logger": "*",
    "@userplane/logger": "*",
    "@userplane/postbridge": "*",
    "@userplane/ui": "*",
    "canvas-confetti": "^1.9.3",
    "dotenv": "^17.2.3",
    "lucide-react": "^0.562.0",
    "next": "^15.4.8",
    "posthog-js": "^1.205.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwindcss": "^4.1.16",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.3",
    "@posthog/nextjs-config": "^1.1.0",
    "@storybook/addon-a11y": "^10.1.11",
    "@storybook/addon-docs": "^10.1.11",
    "@storybook/addon-onboarding": "^10.1.11",
    "@storybook/addon-vitest": "^10.1.11",
    "@storybook/react": "^10.1.11",
    "@storybook/react-vite": "^10.1.11",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20.19.9",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@vitest/browser-playwright": "^4.0.16",
    "@vitest/coverage-v8": "^4.0.16",
    "@userplane/eslint-config": "*",
    "@userplane/typescript-config": "*",
    "concurrently": "^9.2.1",
    "eslint": "^9.32.0",
    "eslint-plugin-storybook": "^10.1.11",
    "playwright": "^1.57.0",
    "storybook": "^10.1.11",
    "tw-animate-css": "^1.3.6",
    "typescript": "^5.9.2",
    "vitest": "^4.0.16"
  }
}

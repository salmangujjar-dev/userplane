              "frameworks/nextjs",
              "frameworks/remix",
              "frameworks/vue",
              "frameworks/angular",
              "frameworks/nuxt",
              "frameworks/sveltekit",
              "frameworks/astro",
              "frameworks/tanstack-start",
              "frameworks/static-html",
              "frameworks/solidjs",
              "frameworks/django",
              "frameworks/ruby-on-rails"
            ]
          },
          {
            "group": "Platform Guides",
            "icon": "grid-2",
            "pages": ["platforms/bolt", "platforms/emergent", "platforms/lovable"]
          },
          {
            "group": "Privacy & Data",
            "icon": "shield-halved",
            "pages": ["developer/sensitive-data-redaction", "developer/recording-data-reference"]
          }
        ]
      },
      {
        "tab": "API",
        "groups": [
          {
            "group": "Getting Started",
            "icon": "rocket",
            "pages": [
              "api/introduction",
              "api/authentication",
              {
                "group": "API Keys",
                "pages": [
                  "api/api-keys",
                  "api/api-keys/create-api-key",

{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Userplane Docs",
  "logo": {
    "dark": "/static/logo-dark.svg",
    "light": "/static/logo-light.svg"
  },
  "favicon": "/static/favicon.svg",
  "api": {
    "playground": {
      "display": "interactive"
    },
    "baseUrl": "https://api.userplane.io/api/v1",
    "auth": {
      "method": "bearer",
      "name": "Authorization",
      "inputPrefix": "Bearer "
    }
  },
  "theme": "aspen",
  "appearance": {
    "default": "light",
    "strict": true
  },
  "colors": {
    "primary": "#000000",
    "light": "#FAFAFA",
    "dark": "#000000"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dash.userplane.io"
    }
  },
  "redirects": [
    {
      "source": "/recording/reusable-links",
      "destination": "/recording-links/reusable"
    },
    {
      "source": "/getting-started/intercom-setup",
      "destination": "/getting-started/helpdesk-setup"
    },
    {
      "source": "/frameworks/bolt",
      "destination": "/platforms/bolt"
    },
    {
      "source": "/frameworks/emergent",
      "destination": "/platforms/emergent"
    },
    {
      "source": "/frameworks/lovable",
      "destination": "/platforms/lovable"
    },
    {
      "source": "/integrations/agent-skills",
      "destination": "/developer/agent-skills"
    },
    {
      "source": "/developer/mcp",
      "destination": "/integrations/mcp-docs"
    }
  ],
  "navigation": {
    "anchors": [
      {
        "anchor": "Contact Support",
        "icon": "life-ring",
        "href": "support/contact"
      }
    ],
    "tabs": [
      {
        "tab": "Guide",
        "groups": [
          {
            "group": "Getting Started",
            "icon": "rocket",
            "pages": ["introduction", "quickstart"]
          },
          {
            "group": "Setup & Onboarding",
            "icon": "wrench",
            "pages": [
              "getting-started/workspace-setup",
              "getting-started/helpdesk-setup",
              "getting-started/for-support-agents",
              "getting-started/for-support-engineers",
              "getting-started/for-developers"
            ]
          },
          {
            "group": "Recordings",
            "icon": "video",
            "pages": [
              {
                "group": "Capture",
                "pages": [
                  "recording/requesting",
                  "recording-links/reusable",
                  "recording/link-reference",
                  "recording/domains"
                ]
              },
              {
                "group": "Review",
                "pages": [
                  "recording/reviewing",
                  "recording/playback",
                  "recording/issue-analyzer",
                  "recording/sharing",
                  "recording/expiry",
                  "recording/projects"
                ]
              },
              {
                "group": "Link Settings",
                "pages": [
                  "recording-links/managing",
                  "recording-links/overview",
                  "recording-links/branding",
                  "recording-links/domain-preferences",
                  "recording-links/limits",
                  "recording-links/sensitive-data-redaction",
                  "recording-links/link-metadata"
                ]
              }
            ]
          },
          {
            "group": "Workspace",
            "icon": "building",
            "pages": [
              {
                "group": "Team & Access",
                "pages": [
                  "workspace/team-management",
                  "workspace/roles-permissions",
                  "workspace/invite-policies",
                  "workspace/access-management"
                ]
              },
              {
                "group": "Projects",
                "pages": ["workspace/projects", "workspace/project-lifecycle"]
              },
              {
                "group": "Domains",
                "pages": [
                  "workspace/domains",
                  "workspace/domain-management",
                  "workspace/domain-verification"
                ]
              },
              "workspace/workspace-lifecycle"
            ]
          },
          {
            "group": "Account",
            "icon": "circle-user",
            "pages": [
              "account/profile",
              "account/notifications",
              "account/connections",
              "account/leaving-workspace"
            ]
          },
          {
            "group": "Billing",
            "icon": "credit-card",
            "pages": [
              "billing/overview",
              "billing/trial",
              {
                "group": "Plans & Usage",
                "pages": [
                  "billing/usage-limits",
                  "billing/monitoring-usage",
                  "billing/upgrading",
                  "billing/downgrading",
                  "billing/seat-add-ons"
                ]
              }
            ]
          },
          {
            "group": "Support",
            "icon": "life-ring",
            "pages": ["support/contact", "support/data-governance"]
          }
        ]
      },
      {
        "tab": "Developer",
        "groups": [
          {
            "group": "Getting Started",
            "icon": "rocket",
            "pages": ["developer/installation", "developer/domain-verification"]
          },
          {
            "group": "AI Agents",
            "icon": "robot",
            "pages": ["developer/agent-skills"]
          },
          {
            "group": "SDK Reference",
            "icon": "cube",
            "pages": ["developer/sdk-overview", "developer/web-sdk", "developer/metadata-sdk"]

{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Userplane Docs",
  "logo": {
    "dark": "/static/logo-dark.svg",
    "light": "/static/logo-light.svg"
  },
  "favicon": "/static/favicon.svg",
  "api": {
    "playground": {
      "display": "interactive"
    },
    "baseUrl": "https://api.userplane.com/api/v1",
    "auth": {
      "method": "bearer",
      "name": "Authorization",
      "inputPrefix": "Bearer "
    }
  },
  "theme": "aspen",
  "appearance": {
    "default": "light",
    "strict": true
  },
  "colors": {
    "primary": "#000000",
    "light": "#FAFAFA",
    "dark": "#000000"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dash.userplane.io"
    }
  },
  "redirects": [
    {
      "source": "/recording/reusable-links",
      "destination": "/recording-links/reusable"
    },
    {
      "source": "/getting-started/intercom-setup",
      "destination": "/getting-started/helpdesk-setup"
    },
    {
      "source": "/frameworks/bolt",
      "destination": "/platforms/bolt"
    },
    {
      "source": "/frameworks/emergent",
      "destination": "/platforms/emergent"
    },
    {
      "source": "/frameworks/lovable",
      "destination": "/platforms/lovable"
    }
  ],
  "navigation": {
    "anchors": [
      {
        "anchor": "Contact Support",
        "icon": "life-ring",
        "href": "support/contact"
      }
    ],
    "tabs": [
      {
        "tab": "Guide",
        "groups": [
          {
            "group": "Getting Started",
            "icon": "rocket",
            "pages": ["introduction", "quickstart"]
          },
          {
            "group": "Setup & Onboarding",
            "icon": "wrench",
            "pages": [
              "getting-started/workspace-setup",
              "getting-started/helpdesk-setup",
              "getting-started/for-support-agents",
              "getting-started/for-support-engineers",
              "getting-started/for-developers"
            ]
          },
          {
            "group": "Recordings",
            "icon": "video",
            "pages": [
              {
                "group": "Capture",
                "pages": [
                  "recording/requesting",
                  "recording-links/reusable",
                  "recording/link-reference",
                  "recording/domains"
                ]
              },
              {
                "group": "Review",
                "pages": [
                  "recording/reviewing",
                  "recording/playback",
                  "recording/issue-analyzer",
                  "recording/sharing",
                  "recording/expiry",
                  "recording/projects"
                ]
              },
              {
                "group": "Link Settings",
                "pages": [
                  "recording-links/managing",
                  "recording-links/overview",
                  "recording-links/branding",
                  "recording-links/domain-preferences",
                  "recording-links/limits",
                  "recording-links/sensitive-data-redaction",
                  "recording-links/link-metadata"
                ]
              }
            ]
          },
          {
            "group": "Workspace",
            "icon": "building",
            "pages": [
              {
                "group": "Team & Access",
                "pages": [
                  "workspace/team-management",
                  "workspace/roles-permissions",
                  "workspace/invite-policies",
                  "workspace/access-management"
                ]
              },
              {
                "group": "Projects",
                "pages": ["workspace/projects", "workspace/project-lifecycle"]
              },
              {
                "group": "Domains",
                "pages": [
                  "workspace/domains",
                  "workspace/domain-management",
                  "workspace/domain-verification"
                ]
              },
              "workspace/workspace-lifecycle"
            ]
          },
          {
            "group": "Account",
            "icon": "circle-user",
            "pages": ["account/profile", "account/notifications", "account/leaving-workspace"]
          },
          {
            "group": "Billing",
            "icon": "credit-card",
            "pages": [
              "billing/overview",
              "billing/trial",
              {
                "group": "Plans & Usage",
                "pages": [
                  "billing/usage-limits",
                  "billing/monitoring-usage",
                  "billing/upgrading",
                  "billing/downgrading",
                  "billing/seat-add-ons"
                ]
              }
            ]
          },
          {
            "group": "Support",
            "icon": "life-ring",
            "pages": ["support/contact", "support/data-governance"]
          }
        ]
      },
      {
        "tab": "Developer",
        "groups": [
          {
            "group": "Getting Started",
            "icon": "rocket",
            "pages": ["developer/installation", "developer/domain-verification"]
          },
          {
            "group": "AI Agents",
            "icon": "robot",
            "pages": ["integrations/agent-skills", "integrations/mcp"]
          },
          {
            "group": "SDK Reference",
            "icon": "cube",
            "pages": ["developer/sdk-overview", "developer/web-sdk", "developer/metadata-sdk"]
          },
          {
            "group": "Framework Guides",
            "icon": "code",
            "pages": [
              "frameworks/react",
              "frameworks/nextjs",
              "frameworks/remix",
              "frameworks/vue",
              "frameworks/angular",
              "frameworks/nuxt",
              "frameworks/sveltekit",
              "frameworks/astro",
              "frameworks/tanstack-start",
              "frameworks/static-html",
              "frameworks/solidjs",
              "frameworks/django",
              "frameworks/ruby-on-rails"
            ]
          },
          {
            "group": "Platform Guides",
            "icon": "grid-2",
            "pages": ["platforms/bolt", "platforms/emergent", "platforms/lovable"]
          },
          {
            "group": "Privacy & Data",
            "icon": "shield-halved",
            "pages": ["developer/sensitive-data-redaction", "developer/recording-data-reference"]
          }
        ]
      },
      {
        "tab": "API",
        "groups": [
          {
            "group": "Getting Started",
            "icon": "rocket",
            "pages": [
              "api/introduction",
              "api/authentication",
              {
                "group": "API Keys",
                "pages": [
                  "api/api-keys",
                  "api/api-keys/create-api-key",
                  "api/api-keys/list-api-keys",
                  "api/api-keys/rotate-api-key",
                  "api/api-keys/revoke-api-key"
                ]
              },
              "api/quickstart"
            ]
          },
          {
            "group": "Concepts",
            "icon": "book",
            "pages": [
              "api/rate-limits",
              "api/error-handling",
              "api/pagination",
              "api/best-practices"
            ]
          },
          {
            "group": "User",
            "icon": "user",
            "pages": ["api/user/get-me"]
          },
          {
            "group": "Workspaces",
            "icon": "building",
            "pages": [
              "api/workspaces/list-workspaces",
              "api/workspaces/get-workspace",
              "api/workspaces/get-invite-url"
            ]
          },
          {
            "group": "Projects",
            "icon": "folder",
            "pages": ["api/projects/list-projects", "api/projects/get-project"]
          },
          {
            "group": "Links",
            "icon": "link",
            "pages": [
              "api/links/list-links",
              "api/links/create-link",
              "api/links/get-link",
              "api/links/update-link",
              "api/links/delete-link"
            ]
          },
          {
            "group": "Recordings",
            "icon": "video",
            "pages": [
              "api/recordings/list-recordings",
              "api/recordings/get-recording",
              "api/recordings/delete-recording",
              "api/recordings/get-recording-resources"
            ]
          }
        ]
      },
      {
        "tab": "Integrations",
        "groups": [
          {
            "group": "Help Desk",
            "icon": "headset",
            "pages": [
              {
                "group": "Intercom",
                "pages": [
                  "integrations/intercom",
                  "integrations/intercom-inbox",
                  "integrations/intercom-shortcuts",
                  "integrations/intercom-macros",
                  "integrations/intercom-notifications"
                ]
              },
              {
                "group": "Zendesk",
                "pages": [
                  "integrations/zendesk",
                  "integrations/zendesk-ticket-sidebar",
                  "integrations/zendesk-ticket-editor",
                  "integrations/zendesk-top-bar",
                  "integrations/zendesk-notifications"
                ]
              },
              {
                "group": "Slack",
                "pages": [
                  "integrations/slack",
                  "integrations/slack-home",
                  "integrations/slack-commands",
                  "integrations/slack-shortcuts",
                  "integrations/slack-notifications"
                ]
              },
              {
                "group": "Chrome Extension",
                "pages": [
                  "integrations/chrome-extension",
                  "integrations/chrome-extension-side-panel",
                  "integrations/chrome-extension-create-links",
                  "integrations/chrome-extension-manage-links",
                  "integrations/chrome-extension-recordings",
                  "integrations/chrome-extension-shortcuts",
                  "integrations/chrome-extension-settings"
                ]
              },
              "integrations/other-helpdesks"
            ]
          },
          {
            "group": "AI Agents",
            "icon": "robot",
            "pages": ["integrations/mcp", "integrations/agent-skills"]
          }
        ]
      }
    ]
  }
}

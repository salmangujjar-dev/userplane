---
import HomepageLayout from '../layouts/HomepageLayout.astro';
import { getCollection } from 'astro:content';
import SupportHeader from '../components/help/SupportHeader';
import TopicGrid from '../components/help/TopicGrid';
import FAQ from '../components/home/FAQ';
import { HELP_TOPICS } from '../constants/help';

// Count articles per topic by parsing the directory prefix from each article id
const allArticles = await getCollection('help');

const articleCountByTopic = new Map<string, number>();
for (const article of allArticles) {
  const topicSlug = article.id.split('/')[0];
  if (topicSlug) {
    articleCountByTopic.set(topicSlug, (articleCountByTopic.get(topicSlug) ?? 0) + 1);
  }
}

const topics = HELP_TOPICS.map((topic) => ({
  topic,
  articleCount: articleCountByTopic.get(topic.slug) ?? 0,
}));
---

<HomepageLayout
  title="Help Center | Userplane"
  description="Find answers, guides, and resources to get the most out of Userplane"
  keywords="userplane help, help center, screen recording help, intercom integration help, userplane faq"
>
  <div
    class="mx-auto flex w-full max-w-7xl flex-col items-center justify-start px-6 md:px-12 text-center py-12"
  >
    <SupportHeader />
    <TopicGrid topics={topics} />
  </div>
  <FAQ client:load />
</HomepageLayout>

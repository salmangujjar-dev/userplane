---
import HomepageLayout from '../layouts/HomepageLayout.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import SupportHeader from '../components/help/SupportHeader';
import TopicGrid from '../components/help/TopicGrid';
import FAQ from '../components/shared/FAQ';
import { HELP_TOPICS } from '../constants/help/help';
import { FAQ_ITEMS } from '../constants/home/faq';

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ_ITEMS.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Help Center',
      item: new URL('/help', Astro.site).href,
    },
  ],
};
---

<HomepageLayout
  title="Help Center | Userplane"
  description="Find answers, guides, and resources to get the most out of Userplane"
  keywords="userplane help, help center, screen recording help, customer support help, userplane faq, getting started, integrations help"
>
  <JsonLd data={breadcrumb} />
  <JsonLd data={faqLd} />
  <div
    class="mx-auto flex w-full max-w-7xl flex-col items-center justify-start px-6 md:px-12 text-center py-12"
  >
    <SupportHeader />
    <TopicGrid topics={HELP_TOPICS} />
  </div>
  <FAQ client:load />
</HomepageLayout>

---
import BlogLayout from '../../../layouts/BlogLayout.astro';
import { getCollection, render } from 'astro:content';
import { SUPPORT_TOPICS } from '../../../constants/support';
import { NAV_LINKS, getSupportTopicUrl } from '../../../constants/navigation';

export async function getStaticPaths() {
  const allArticles = await getCollection('support');

  return allArticles.map((article) => {
    const parts = article.id.split('/');
    const topicSlug = parts[0]!;
    const articleSlug = parts.pop()!.replace('.md', '');

    return {
      params: { topic: topicSlug, slug: articleSlug },
      props: { article, topicSlug },
    };
  });
}

const { article, topicSlug } = Astro.props;
const { Content } = await render(article);
const topic = SUPPORT_TOPICS.find((t) => t.slug === topicSlug);
---

<BlogLayout title={`${article.data.title} | Userplane Support`} description={article.data.excerpt}>
  <article class="container mx-auto px-4 py-16 max-w-4xl">
    <!-- Breadcrumb -->
    <nav class="mb-8">
      <ol class="flex items-center gap-2 text-sm text-muted-foreground">
        <li>
          <a href={NAV_LINKS.support} class="hover:text-primary transition-colors">Support</a>
        </li>
        <li>/</li>
        <li>
          <a href={getSupportTopicUrl(topicSlug)} class="hover:text-primary transition-colors">
            {topic?.title ?? topicSlug}
          </a>
        </li>
        <li>/</li>
        <li class="text-zinc-900 font-medium">{article.data.title}</li>
      </ol>
    </nav>

    <header class="mb-12">
      <h1 class="text-5xl font-bold mb-4 font-dm-sans">{article.data.title}</h1>
      <p class="text-lg text-muted-foreground">{article.data.excerpt}</p>
    </header>

    <div
      class="prose prose-lg prose-zinc max-w-none
        prose-headings:font-dm-sans prose-headings:font-semibold
        prose-h1:text-4xl prose-h1:mb-6 prose-h1:mt-12
        prose-h2:text-3xl prose-h2:mb-4 prose-h2:mt-10
        prose-h3:text-2xl prose-h3:mb-3 prose-h3:mt-8
        prose-p:text-zinc-700 prose-p:leading-relaxed prose-p:mb-6
        prose-li:text-zinc-700 prose-li:leading-relaxed
        prose-strong:text-zinc-900 prose-strong:font-semibold
        prose-a:text-blue-600 prose-a:no-underline hover:prose-a:underline
        prose-ul:my-6 prose-ol:my-6"
    >
      <Content />
    </div>
  </article>
</BlogLayout>

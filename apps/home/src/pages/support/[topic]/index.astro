---
import HomepageLayout from '../../../layouts/HomepageLayout.astro';
import { getCollection } from 'astro:content';
import ArticleList from '../../../components/support/ArticleList';
import TopicHeader from '../../../components/support/TopicHeader';
import { SUPPORT_TOPICS } from '../../../constants/support';
import { NAV_LINKS } from '../../../constants/navigation';

export async function getStaticPaths() {
  const allArticles = await getCollection('support');

  return SUPPORT_TOPICS.map((topic) => {
    // Collect articles whose id starts with this topic slug
    const articles = allArticles
      .filter((a) => a.id.startsWith(`${topic.slug}/`))
      .sort((a, b) => a.data.order - b.data.order)
      .map((a) => ({
        slug: a.id.split('/').pop()!.replace('.md', ''),
        topic: topic.slug,
        title: a.data.title,
        excerpt: a.data.excerpt,
      }));

    return {
      params: { topic: topic.slug },
      props: { topic, articles },
    };
  });
}

const { topic, articles } = Astro.props;
---

<HomepageLayout title={`${topic.title} | Userplane Support`} description={topic.subtitle}>
  <div
    class="mx-auto flex w-full max-w-7xl flex-col items-center justify-start px-6 md:px-12 py-12"
  >
    <!-- Breadcrumb -->
    <nav class="w-full max-w-4xl mb-8 text-left">
      <ol class="flex items-center gap-2 text-sm text-muted-foreground">
        <li>
          <a href={NAV_LINKS.support} class="hover:text-primary transition-colors">Support</a>
        </li>
        <li>/</li>
        <li class="text-zinc-900 font-medium">{topic.title}</li>
      </ol>
    </nav>

    <TopicHeader topic={topic} />
    <ArticleList articles={articles} />
  </div>
</HomepageLayout>

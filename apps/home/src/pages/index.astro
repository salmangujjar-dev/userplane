---
import HomepageLayout from '../layouts/HomepageLayout.astro';
import Hero from '../components/home/v3/Hero';
import Spotlight from '../components/home/v3/Spotlight';
import Pricing from '../components/home/v3/Pricing';
import Features from '../components/home/v3/Features';
import FAQ from '../components/home/v3/FAQ';
import CTA from '../components/home/v3/CTA';
---

<HomepageLayout>
  <main class="flex flex-col items-center">
    <Hero />
    <Spotlight />
    <Features client:load />
    <Pricing client:visible />
    <FAQ client:load />
    <CTA />
  </main>
</HomepageLayout>

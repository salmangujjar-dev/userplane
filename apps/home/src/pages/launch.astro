---
import LaunchLayout from '../layouts/LaunchLayout.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import LaunchHero from '../components/launch/Hero';
import LogoMarquee from '../components/integrations/LogoMarquee';
import FeatureShowcase from '../components/integrations/FeatureShowcase';
import ResourceLinks from '../components/integrations/ResourceLinks';
import CallToAction from '../components/integrations/CallToAction';

import {
  LAUNCH_GRADIENT,
  LAUNCH_HERO,
  LAUNCH_LOGOS_LABEL,
  LAUNCH_FEATURES,
  LAUNCH_RESOURCES,
  LAUNCH_CTA,
  LAUNCH_LISTING_BADGES,
} from '../constants/launch/general';
import { INTEGRATION_LOGOS } from '../constants/integrations';
import { STATIC_PAGE_REGISTRY } from '../constants/static-pages';
import { getOgImagePath } from '../lib/og/sources';

const meta = STATIC_PAGE_REGISTRY.launch;

const gradientVars = `--gradient-1: ${LAUNCH_GRADIENT.stops[0]}; --gradient-2: ${LAUNCH_GRADIENT.stops[1]}; --gradient-3: ${LAUNCH_GRADIENT.stops[2]}; --gradient-4: ${LAUNCH_GRADIENT.stops[3]};`;

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: new URL('/', Astro.site).href,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Launch',
      item: new URL('/launch', Astro.site).href,
    },
  ],
};
---

<LaunchLayout
  title={meta.seo.title}
  description={meta.seo.description}
  keywords={meta.seo.keywords}
  ogImage={getOgImagePath(meta.category, meta.slug)}
  ogImageAlt={meta.og.alt}
  preloadImage={LAUNCH_HERO.screenshot}
  listingBadges={LAUNCH_LISTING_BADGES}
>
  <JsonLd data={breadcrumb} />
  <main class="flex flex-col" style={gradientVars}>
    <LaunchHero
      headline={LAUNCH_HERO.headline}
      description={LAUNCH_HERO.description}
      primaryCTA={LAUNCH_HERO.primaryCTA}
      secondaryCTA={LAUNCH_HERO.secondaryCTA}
      screenshot={LAUNCH_HERO.screenshot}
    />
    <LogoMarquee label={LAUNCH_LOGOS_LABEL} logos={INTEGRATION_LOGOS} />
    <FeatureShowcase features={LAUNCH_FEATURES} />
    <ResourceLinks
      label={LAUNCH_RESOURCES.label}
      headline={LAUNCH_RESOURCES.headline}
      links={LAUNCH_RESOURCES.links}
      footerLinks={LAUNCH_RESOURCES.footerLinks}
    />
    <CallToAction
      headline={LAUNCH_CTA.headline}
      description={LAUNCH_CTA.description}
      primaryCTA={LAUNCH_CTA.primaryCTA}
      secondaryCTA={LAUNCH_CTA.secondaryCTA}
    />
  </main>
</LaunchLayout>

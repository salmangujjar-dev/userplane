---
import HomepageLayout from '../layouts/HomepageLayout.astro';
import { RoadmapComponent, type RoadmapProps } from '../components/home/Roadmap';
import { TALLY_FEATURE_REQUEST_URL } from '../constants/contact';

/**
 * Roadmap item structure:
 * {
 *   title: string - feature title (lowercase)
 *   description: string - brief description of the feature
 *   status: 'planned' | 'inProgress' | 'completed' - current status
 *   date: string - target date or quarter (e.g., 'Q4 2025', '2025')
 * }
 */
const roadmapItems: RoadmapProps[] = [
  // Example items - replace with Userplane roadmap items:
  // {
  //   title: 'slack integration',
  //   description: 'send screen recordings directly to slack channels for team collaboration.',
  //   status: 'planned',
  //   date: 'Q2 2026',
  // },
  // {
  //   title: 'advanced console filtering',
  //   description: 'filter and search through console logs with advanced query syntax.',
  //   status: 'inProgress',
  //   date: 'Q1 2026',
  // },
  // {
  //   title: 'one-click screen recording',
  //   description: 'capture screen recordings with console logs and network data in one click.',
  //   status: 'completed',
  //   date: 'Q4 2025',
  // },
];
---

<HomepageLayout
  title="Roadmap — Userplane"
  description="See what's coming next and help shape our development priorities."
>
  <div
    class="mx-auto flex w-full max-w-7xl flex-col items-center justify-start px-12 text-center py-12"
  >
    <div class="mb-8 flex flex-col items-center justify-center gap-6 text-center">
      <h1 class="font-dm-sans font-medium text-4xl leading-tight tracking-[-2px] md:text-6xl">
        <span class="relative">
          <span class="relative z-10 text-black">Roadmap</span>
          <span
            class="-translate-y-1/2 -rotate-1 -z-10 absolute inset-0 top-1/2 transform rounded-md bg-yellow-200 py-6 md:py-8"
          ></span>
        </span>
      </h1>
      <p class="md:text-lg max-w-2xl text-muted-foreground">
        See what&apos;s coming next and shape our{' '}
        <a
          href={TALLY_FEATURE_REQUEST_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="text-black hover:underline font-semibold"
        >
          priorities
        </a>
        .
      </p>
    </div>
    <div class="w-full text-left">
      <RoadmapComponent items={roadmapItems} />
    </div>
  </div>
</HomepageLayout>

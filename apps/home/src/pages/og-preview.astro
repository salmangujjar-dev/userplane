---
// Dev-only grid for eyeballing all generated OG images.
// Redirects to home in production so nothing is indexed.
import { enumerateOgSources, getOgImagePath } from '@/lib/og/sources';

if (!import.meta.env.DEV) {
  return Astro.redirect('/');
}

const sources = await enumerateOgSources();
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>OG Preview — {sources.length} images</title>
    <style>
      body {
        background: #e5e5e5;
        padding: 32px;
        font-family: system-ui, sans-serif;
        color: #111;
      }
      h1 {
        margin-bottom: 32px;
        font-size: 20px;
      }
      .grid {
        display: flex;
        flex-direction: column;
        gap: 32px;
      }
      figure {
        margin: 0;
      }
      figcaption {
        font-size: 12px;
        color: #666;
        margin-bottom: 6px;
        font-family: monospace;
      }
      img {
        display: block;
        border: 1px solid #ccc;
        border-radius: 4px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
      }
    </style>
  </head>
  <body>
    <h1>OG image preview &mdash; {sources.length} images</h1>
    <div class="grid">
      {
        sources.map((s) => (
          <figure>
            <figcaption>{getOgImagePath(s.category, s.slug)}</figcaption>
            <img
              src={getOgImagePath(s.category, s.slug)}
              width="600"
              height="315"
              alt={s.alt}
              loading="lazy"
            />
          </figure>
        ))
      }
    </div>
  </body>
</html>

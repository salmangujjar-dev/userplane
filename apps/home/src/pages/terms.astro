---
import { getEntry, render } from 'astro:content';
import LegalLayout from '../layouts/LegalLayout.astro';
import { STATIC_PAGE_REGISTRY } from '../constants/static-pages';
import { getOgImagePath } from '../lib/og/sources';

const meta = STATIC_PAGE_REGISTRY.terms;

const entry = await getEntry('legal', 'terms');
if (!entry) {
  throw new Error('Terms of service content not found');
}
const { Content } = await render(entry);
---

<LegalLayout
  title={meta.seo.title}
  description={meta.seo.description}
  keywords={meta.seo.keywords}
  ogImage={getOgImagePath(meta.category, meta.slug)}
  ogImageAlt={meta.og.alt}
>
  <article class="legal flex flex-col gap-12">
    <section class="flex flex-col gap-4">
      <h1
        class="text-center font-dm-sans font-medium text-4xl leading-tight tracking-[-2px] md:text-6xl"
      >
        <span class="relative">
          <span class="relative z-10 text-black">Terms</span>
          <span
            class="-translate-y-1/2 -rotate-1 -z-10 absolute inset-0 top-1/2 transform rounded-md bg-green-200 py-6 md:py-8"
          ></span>
        </span>{' '}
        of Service
      </h1>
      <div class="text-center text-muted-foreground text-sm mt-4">
        Last updated: {
          entry.data.lastUpdated.toLocaleDateString('en-US', {
            month: 'long',
            day: 'numeric',
            year: 'numeric',
          })
        }
      </div>
    </section>

    <div
      class="prose prose-lg prose-zinc max-w-none
            prose-headings:font-dm-sans prose-headings:font-semibold
            prose-h2:text-2xl prose-h2:mb-4 prose-h2:mt-8
            prose-h3:text-xl prose-h3:mb-3 prose-h3:mt-6
            prose-p:text-zinc-700 prose-p:leading-relaxed prose-p:mb-4
            prose-li:text-zinc-700 prose-li:leading-relaxed
            prose-strong:text-zinc-900 prose-strong:font-semibold
            prose-a:text-blue-600 prose-a:no-underline hover:prose-a:underline
            prose-ul:my-4 prose-ol:my-4
            prose-blockquote:border-l-4 prose-blockquote:border-amber-400 prose-blockquote:bg-amber-50 prose-blockquote:p-4 prose-blockquote:my-4"
    >
      <Content />
    </div>
  </article>
</LegalLayout>

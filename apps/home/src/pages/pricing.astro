---
import HomepageLayout from '../layouts/HomepageLayout.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import PricingPage from '../components/pricing/PricingPage';
import { PRICING_FAQ_ITEMS } from '../constants/pricing/pricing-page';
import { STATIC_PAGE_REGISTRY } from '../constants/static-pages';
import { getOgImagePath } from '../lib/og/sources';

const meta = STATIC_PAGE_REGISTRY.pricing;

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: PRICING_FAQ_ITEMS.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const softwareLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Userplane',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  offers: {
    '@type': 'Offer',
    price: '79',
    priceCurrency: 'USD',
    priceValidUntil: new Date(Date.now() + 365 * 86400000).toISOString().split('T')[0],
    availability: 'https://schema.org/InStock',
  },
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Pricing',
      item: new URL('/pricing', Astro.site).href,
    },
  ],
};
---

<HomepageLayout
  title={meta.seo.title}
  description={meta.seo.description}
  keywords={meta.seo.keywords}
  ogImage={getOgImagePath(meta.category, meta.slug)}
  ogImageAlt={meta.og.alt}
>
  <JsonLd data={breadcrumb} />
  <JsonLd data={softwareLd} />
  <JsonLd data={faqLd} />
  <main class="flex flex-col items-center">
    <PricingPage client:load />
  </main>
</HomepageLayout>

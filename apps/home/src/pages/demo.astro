---
import HomepageLayout from '../layouts/HomepageLayout.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import Highlight from '../components/shared/Highlight';
import { STATIC_PAGE_REGISTRY } from '../constants/static-pages';
import { getOgImagePath } from '../lib/og/sources';

const meta = STATIC_PAGE_REGISTRY.demo;

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
    { '@type': 'ListItem', position: 2, name: 'Demo', item: new URL('/demo', Astro.site).href },
  ],
};
---

<HomepageLayout
  title={meta.seo.title}
  description={meta.seo.description}
  keywords={meta.seo.keywords}
  ogImage={getOgImagePath(meta.category, meta.slug)}
  ogImageAlt={meta.og.alt}
>
  <JsonLd data={breadcrumb} />
  <div
    class="mx-auto flex w-full max-w-7xl flex-col items-center justify-start px-6 md:px-12 text-center py-12"
  >
    <div class="mb-12 flex flex-col items-center justify-center gap-6 text-center">
      <h1 class="font-dm-sans font-medium text-4xl leading-tight tracking-[-2px] md:text-6xl">
        See it in <Highlight color="blue">action</Highlight>
      </h1>
      <p class="md:text-lg max-w-2xl text-muted-foreground">
        Request screen recordings from your customers showing exactly what went wrong
      </p>
    </div>

    <div
      class="relative w-full max-w-5xl"
      style="padding-bottom: calc(49.895833333333336% + 41px);"
    >
      <iframe
        src="https://demo.arcade.software/QT8yTBO40pXFNmpbVef4?embed&embed_mobile=tab&embed_desktop=inline&show_copy_link=true"
        title="Userplane interactive product demo"
        loading="lazy"
        allowfullscreen
        allow="clipboard-write"
        class="absolute inset-0 h-full w-full"
        style="color-scheme: light; border: 0;"
      >
      </iframe>
    </div>
  </div>
</HomepageLayout>

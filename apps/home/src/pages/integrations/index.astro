---
import HomepageLayout from '../../layouts/HomepageLayout.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import Hero from '../../components/integrations/Hero';
import LogoMarquee from '../../components/integrations/LogoMarquee';
import IntegrationBrowser from '../../components/integrations/IntegrationBrowser';
import CallToAction from '../../components/integrations/CallToAction';
import { INTEGRATION_REGISTRY } from '../../constants/integrations/registry';
import { INTEGRATION_LOGOS, INTEGRATION_LOGOS_LABEL } from '../../constants/integrations';
import { LISTING_GRADIENT, LISTING_HERO, LISTING_CTA } from '../../constants/integrations/listing';
import { STATIC_PAGE_REGISTRY } from '../../constants/static-pages';
import { getOgImagePath } from '../../lib/og/sources';

const meta = STATIC_PAGE_REGISTRY.integrationsListing;

const integrations = Object.values(INTEGRATION_REGISTRY);

const browserEntries = integrations.map((config) => ({
  slug: config.slug,
  name: config.shortName,
  description: config.seo.description,
  pageHref: `/integrations/${config.slug}`,
  docsHref: config.resources.seeAllHref,
  image: config.hero.preview
    ? { src: config.hero.preview.src, alt: config.hero.preview.alt }
    : undefined,
  gradientStops: config.gradient.stops,
  resources: config.browser.links.map((l) => ({
    label: l.label,
    title: l.title,
    description: l.description,
    href: l.href,
  })),
}));

const gradientVars = LISTING_GRADIENT.stops
  .map((stop, i) => `--gradient-${i + 1}: ${stop}`)
  .join('; ');

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: new URL('/', Astro.site).href,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Integrations',
      item: new URL('/integrations', Astro.site).href,
    },
  ],
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Userplane Integrations',
  description: meta.seo.description,
  url: new URL('/integrations', Astro.site).href,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: integrations.map((config, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: new URL(`/integrations/${config.slug}`, Astro.site).href,
      name: `Userplane for ${config.name}`,
    })),
  },
};
---

<HomepageLayout
  title={meta.seo.title}
  description={meta.seo.description}
  keywords={meta.seo.keywords}
  ogImage={getOgImagePath(meta.category, meta.slug)}
  ogImageAlt={meta.og.alt}
  preloadImage={{
    src: LISTING_HERO.preview.src,
    srcSet: '',
    sizes: '(max-width: 1024px) 100vw, 52vw',
  }}
>
  <JsonLd data={breadcrumb} />
  <JsonLd data={jsonLd} />
  <main class="flex flex-col" style={gradientVars}>
    <Hero
      headline={LISTING_HERO.headline}
      description={LISTING_HERO.description}
      primaryCTA={LISTING_HERO.primaryCTA}
      secondaryCTA={LISTING_HERO.secondaryCTA}
      preview={LISTING_HERO.preview}
    />
    <LogoMarquee label={INTEGRATION_LOGOS_LABEL} logos={INTEGRATION_LOGOS} />

    <IntegrationBrowser integrations={browserEntries} client:visible />
    <CallToAction
      headline={LISTING_CTA.headline}
      description={LISTING_CTA.description}
      primaryCTA={LISTING_CTA.primaryCTA}
      secondaryCTA={LISTING_CTA.secondaryCTA}
    />
  </main>
</HomepageLayout>

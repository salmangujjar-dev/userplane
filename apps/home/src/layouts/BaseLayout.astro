---
import '@userplane/ui/globals.css';
import { SITE_META } from '../constants/site';
import PostHog from '../components/analytics/posthog.astro';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
  preloadImage?: { src: string; srcSet: string; sizes: string };
}

const {
  title = SITE_META.title,
  description = SITE_META.description,
  keywords = SITE_META.keywords,
  ogImage = SITE_META.ogImage,
  preloadImage,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const absoluteOgImage = ogImage.startsWith('http') ? ogImage : new URL(ogImage, Astro.site).href;
---

<!doctype html>
<html lang="en" class="font-geist" style="color-scheme: light only;">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={SITE_META.favicon} />
    <meta name="color-scheme" content="light only" />
    <style>
      html,
      body {
        color-scheme: light only !important;
      }
    </style>

    {/* Preload LCP image — only when provided by the page */}
    {
      preloadImage && (
        <link
          rel="preload"
          as="image"
          href={preloadImage.src}
          imagesrcset={preloadImage.srcSet}
          imagesizes={preloadImage.sizes}
          fetchpriority="high"
        />
      )
    }

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Userplane" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={SITE_META.locale} />
    <meta property="og:image" content={absoluteOgImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />

    <!-- Analytics -->
    <PostHog />
  </head>
  <body class="bg-background text-foreground antialiased">
    <slot />
  </body>
</html>

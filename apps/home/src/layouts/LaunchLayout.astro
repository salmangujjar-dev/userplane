---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/layout/Header';
import LaunchFooter from '../components/launch/Footer';
import { FRAMEWORK_REGISTRY } from '../constants/frameworks/registry';
import { INTEGRATION_REGISTRY } from '../constants/integrations/registry';
import { ROLE_REGISTRY } from '../constants/roles/registry';
import { NAV_LINKS } from '../constants/navigation';
import { getDocsUrl } from '../constants/urls';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
  ogImageAlt?: string;
  preloadImage?: { src: string; srcSet: string; sizes: string };
  listingBadges?: {
    name: string;
    href: string;
    badge: { src: string; alt: string; width: number; height: number };
  }[];
}

const { title, description, keywords, ogImage, ogImageAlt, preloadImage, listingBadges } =
  Astro.props;

const dropdownEntries = Object.values(INTEGRATION_REGISTRY).map((config) => ({
  slug: config.slug,
  name: config.name,
  shortName: config.shortName,
  description: config.seo.description,
  pageHref: `/integrations/${config.slug}`,
  docsHref: config.resources.seeAllHref,
  icon: config.icon,
  image: config.hero.preview.src
    ? { src: config.hero.preview.src, alt: config.hero.preview.alt }
    : undefined,
  gradientStops: config.gradient.stops,
}));

const frameworkDropdownEntries = Object.values(FRAMEWORK_REGISTRY).map((config) => ({
  slug: config.slug,
  name: config.name,
  shortName: config.shortName,
  description: config.seo.description,
  pageHref: `/frameworks/${config.slug}`,
  docsHref: config.resources.seeAllHref,
  icon: config.icon,
  image: config.hero.preview?.src
    ? { src: config.hero.preview.src, alt: config.hero.preview.alt }
    : undefined,
  gradientStops: config.gradient.stops,
}));

const teamDropdownEntries = Object.values(ROLE_REGISTRY).map((config) => ({
  slug: config.slug,
  name: config.name,
  description: config.seo.description,
  pageHref: `/for/${config.slug}`,
  docsHref: config.resources.seeAllHref,
  image: config.hero.preview
    ? { src: config.hero.preview.src, alt: config.hero.preview.alt }
    : undefined,
  gradientStops: config.gradient.stops,
}));
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  ogImage={ogImage}
  ogImageAlt={ogImageAlt}
  preloadImage={preloadImage}
>
  <Header
    integrations={dropdownEntries}
    integrationsHref={NAV_LINKS.integrations}
    docsHref={getDocsUrl('')}
    frameworks={frameworkDropdownEntries}
    frameworksHref={NAV_LINKS.frameworks}
    teams={teamDropdownEntries}
    teamsHref={NAV_LINKS.solutions}
    client:idle
  />
  <slot />
  <LaunchFooter listingBadges={listingBadges} />
</BaseLayout>

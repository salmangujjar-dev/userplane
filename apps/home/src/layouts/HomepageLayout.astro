---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/layout/Header';
import Footer from '../components/layout/Footer';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
  preloadImage?: { src: string; srcSet: string; sizes: string };
}

const { title, description, keywords, ogImage, preloadImage } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  ogImage={ogImage}
  preloadImage={preloadImage}
>
  <Header client:idle />
  <slot />
  <Footer />
</BaseLayout>

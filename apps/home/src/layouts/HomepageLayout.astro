---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/home/v2/Header';
import Footer from '../components/home/v2/Footer';

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
}

const { title, description, keywords, ogImage } = Astro.props;
---

<BaseLayout title={title} description={description} keywords={keywords} ogImage={ogImage}>
  <Header client:idle />
  <slot />
  <Footer />
</BaseLayout>

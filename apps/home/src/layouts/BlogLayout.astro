---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/home/Header';
import Footer from '../components/home/Footer';

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
}

const { title, description, keywords, ogImage } = Astro.props;
---

<BaseLayout title={title} description={description} keywords={keywords} ogImage={ogImage}>
  <Header client:idle />
  <main class="grow">
    <slot />
  </main>
  <Footer />
</BaseLayout>

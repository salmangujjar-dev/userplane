---
import { FAQ_HEADING, FAQ_HIGHLIGHTS, FAQ_ITEMS } from '@/constants/home/faq';

const highlightColors = {
  blue: 'bg-blue-200',
  yellow: 'bg-yellow-200',
  green: 'bg-green-200',
  purple: 'bg-purple-200',
  red: 'bg-red-200',
};

const words = FAQ_HEADING.title.split(' ');
const highlightMap = new Map(
  FAQ_HIGHLIGHTS.map((highlight) => [highlight.wordIndex, highlight.color])
);
---

<section class="py-16 md:py-24 px-6 md:px-12 w-full overflow-x-hidden" id="faq">
  <div class="max-w-4xl mx-auto w-full">
    <div class="text-center mb-16 w-full">
      <div class="flex flex-col gap-8">
        <p class="text-center text-base text-muted-foreground md:text-lg">{FAQ_HEADING.label}</p>
        <h2
          class="font-dm-sans font-medium text-4xl text-foreground tracking-tighter md:text-5xl lg:text-6xl leading-tight"
        >
          {
            words.map((word, index) => {
              const color = highlightMap.get(index);
              return color ? (
                <>
                  <span class="relative inline-block">
                    <span class="relative z-20 text-black">{word}</span>
                    <span
                      class:list={[
                        'absolute inset-0 top-1/2 -translate-y-1/2 -rotate-1 z-10 rounded-md py-6 md:py-8',
                        highlightColors[color],
                      ]}
                    />
                  </span>{' '}
                </>
              ) : (
                <>{word} </>
              );
            })
          }
        </h2>
        <p class="md:text-lg max-w-2xl mx-auto">{FAQ_HEADING.subtitle}</p>
      </div>
    </div>

    <div class="bg-white rounded-2xl border border-zinc-200 p-6 md:p-8 w-full min-w-0">
      {
        FAQ_ITEMS.map((item) => {
          const link = item.link;
          const linkIndex = link ? item.answer.indexOf(link.text) : -1;
          const hasLink = link && linkIndex >= 0;
          const before = hasLink ? item.answer.slice(0, linkIndex) : item.answer;
          const after = hasLink ? item.answer.slice(linkIndex + link.text.length) : '';

          return (
            <details class="group border-b border-zinc-200 last:border-b-0 w-full min-w-0">
              <summary class="w-full flex cursor-pointer list-none items-center justify-between gap-4 py-6 text-left hover:opacity-80 transition-opacity min-w-0">
                <span class="text-lg font-medium text-foreground flex-1 min-w-0 wrap-break-word overflow-hidden">
                  {item.question}
                </span>
                <span class="shrink-0 flex-none text-muted-foreground">
                  <svg
                    aria-hidden="true"
                    class="w-5 h-5 group-open:hidden"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M5 12h14" />
                    <path d="M12 5v14" />
                  </svg>
                  <svg
                    aria-hidden="true"
                    class="w-5 h-5 hidden group-open:block"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M5 12h14" />
                  </svg>
                </span>
              </summary>
              <div class="pb-6 w-full min-w-0 overflow-hidden pr-8">
                <p class="text-base text-muted-foreground leading-relaxed wrap-break-word overflow-wrap-anywhere">
                  {before}
                  {hasLink && link && (
                    <a href={link.href} class="underline decoration-dotted underline-offset-2">
                      {link.text}
                    </a>
                  )}
                  {after}
                </p>
              </div>
            </details>
          );
        })
      }
    </div>
  </div>
</section>

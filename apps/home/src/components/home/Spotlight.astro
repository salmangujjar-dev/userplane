---
import { SPOTLIGHT_IMAGE, SPOTLIGHT_VIDEO } from '@/constants/home/spotlight';
---

<section class="w-full pt-8 md:pt-12 pb-16 md:pb-24">
  <div class="w-full px-6 md:px-12">
    <div class="relative w-full aspect-video rounded-xl overflow-hidden" data-spotlight>
      <button type="button" class="relative w-full h-full cursor-pointer group" data-spotlight-play>
        <img
          src={SPOTLIGHT_IMAGE.src}
          srcset={SPOTLIGHT_IMAGE.srcSet}
          sizes={SPOTLIGHT_IMAGE.sizes}
          width={SPOTLIGHT_IMAGE.width}
          height={SPOTLIGHT_IMAGE.height}
          alt={SPOTLIGHT_IMAGE.alt}
          fetchpriority="high"
          decoding="async"
          class="w-full h-full object-cover"
          draggable="false"
        />
        <span class="absolute inset-0 flex items-center justify-center">
          <span
            class="flex items-center justify-center w-20 h-20 md:w-28 md:h-28 rounded-full bg-white shadow-2xl transition-transform group-hover:scale-110"
          >
            <svg
              aria-hidden="true"
              class="w-9 h-9 md:w-12 md:h-12 text-gray-900 ml-1"
              viewBox="0 0 24 24"
              fill="currentColor"
            >
              <path d="M8 5v14l11-7z"></path>
            </svg>
            <span class="sr-only">Play video</span>
          </span>
        </span>
      </button>
    </div>
  </div>
</section>

<script is:inline define:vars={{ videoSrc: SPOTLIGHT_VIDEO.src, videoTitle: SPOTLIGHT_VIDEO.title }}
>
  document.addEventListener('click', (event) => {
    const playButton = event.target?.closest?.('[data-spotlight-play]');
    if (!playButton) return;

    const root = playButton.closest('[data-spotlight]');
    if (!root) return;

    const iframe = document.createElement('iframe');
    iframe.src = videoSrc;
    iframe.className = 'absolute inset-0 w-full h-full';
    iframe.allow = 'autoplay; fullscreen; picture-in-picture';
    iframe.allowFullscreen = true;
    iframe.title = videoTitle;
    root.replaceChildren(iframe);
  });
</script>

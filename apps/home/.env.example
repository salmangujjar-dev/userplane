# Home/Marketing App Configuration (Astro)
# Copy this file to .env.development and fill in the values
#
# No external services required for local development
#
# See developers/setup/ for guides on configuring each service

# ==========================================
# Server Configuration
# ==========================================
# Port is pinned in astro.config.mjs and package.json: --port 4321
# PORT=4321

# ==========================================
# Application Environment
# ==========================================
# For Astro apps, the deployment stage is controlled via the --mode CLI flag
# (e.g., astro dev --mode preview) which sets import.meta.env.MODE
#
# Values: development | production
# - development: Development via Cloudflare tunnels (default)
# - production: Production server
#
# No APP_ENV variable needed in this file for Astro apps

# ==========================================
# Runtime Configuration (Required at runtime)
# ==========================================
# These variables are read when the application runs

# Home/Marketing site URL
# Used for internal links, canonical URLs, and navigation
# In production, this should be your marketing domain
PUBLIC_HOME_URL='https://home-dev.userplane.io'

# Dashboard application URL
# Used for links to dashboard, authentication, and app pages
# In production, this should be your app domain
PUBLIC_DASH_URL='https://dash-dev.userplane.io'

# ==========================================
# CDN Configuration
# ==========================================
# CDN domain for media assets (logos, favicons, etc.)
PUBLIC_CDN_DOMAIN='https://cdn-dev.userplane.io'

# Assets domain for user-uploaded content (thumbnails, etc.)
PUBLIC_ASSETS_DOMAIN='https://assets-dev.userplane.io'

# Cloudflare zone for image transforms (e.g., 'userplane.io')
# Used to optimize images on-the-fly via Cloudflare's /cdn-cgi/image/ endpoint
PUBLIC_CLOUDFLARE_IMAGE_ZONE='userplane.io'

# Set to 'true' to disable image transforms (serve original URLs)
# Useful for debugging or when Cloudflare transforms are not available
PUBLIC_SKIP_IMAGE_TRANSFORM='false'

# ==========================================
# PostHog Analytics
# ==========================================
# PostHog project API key (leave empty to disable analytics)
PUBLIC_POSTHOG_KEY=''

# PostHog API host (US: https://i.userplane.io, EU: https://eu.i.posthog.com)
PUBLIC_POSTHOG_HOST='https://i.userplane.io'

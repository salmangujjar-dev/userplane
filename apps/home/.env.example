# Home App Configuration (Astro)
# Copy this file to .env and fill in the values

# ==========================================
# Server Configuration
# ==========================================
# Port is pinned in astro.config.mjs and package.json: --port 4321
# PORT=4321

# ==========================================
# API Configuration (Required)
# ==========================================
# The API server URL - where your Hono API is running
PUBLIC_API_URL=http://localhost:3001

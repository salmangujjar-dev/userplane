# Home App Configuration (Astro)
# Copy this file to .env and fill in the values

# ==========================================
# Server Configuration
# ==========================================
# Port is pinned in astro.config.mjs and package.json: --port 4321
# PORT=4321

# ==========================================
# Home/Marketing Configuration (Optional)
# ==========================================
# The Home/Marketing site URL - used for internal links
PUBLIC_HOME_URL=http://localhost:4321

# ==========================================
# Dashboard Configuration (Required)
# ==========================================
# The Dashboard URL - where your dashboard/app is running
PUBLIC_DASH_URL=http://localhost:3000

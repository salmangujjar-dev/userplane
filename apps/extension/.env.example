# Chrome Extension Configuration (WXT)
# Copy this file to .env.development and fill in the values
#
# REQUIRED: WXT_API_URL — your API server URL (tunnel or localhost)
# OPTIONAL: Everything else — features degrade gracefully without credentials
#
# See developers/setup/ for guides on configuring each service

# API URL for the extension to communicate with
WXT_API_URL=https://api-dev.userplane.io

# Dashboard URL for auth flow redirect
WXT_DASH_URL=https://dash-dev.userplane.io

# CDN for media assets
WXT_CDN_DOMAIN=https://cdn.userplane.io
WXT_CLOUDFLARE_IMAGE_ZONE=userplane.io
WXT_SKIP_IMAGE_TRANSFORM=true

# PostHog Configuration
WXT_POSTHOG_KEY=
WXT_POSTHOG_HOST=https://i.userplane.io

# Build-time only: PostHog source map uploads
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

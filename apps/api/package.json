{
  "dependencies": {
    "@hono/zod-openapi": "^1.1.5",
    "@hono/zod-validator": "^0.4.1",
    "@orpc/openapi": "^1.12.3",
    "@orpc/server": "^1.12.3",
    "@userplane/auth": "*",
    "@userplane/cache": "*",
    "@userplane/contract": "*",
    "@userplane/db": "*",
    "@userplane/email": "*",
    "@userplane/common-logger": "*",
    "@userplane/payments": "*",
    "@userplane/pricing": "*",
    "@userplane/shared": "*",
    "@userplane/storage": "*",
    "hono": "^4.6.16",
    "inngest": "^3.27.0",
    "posthog-node": "^4.3.1",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.1.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "slugify": "^1.6.6",
    "stoker": "^2.0.1",
    "uuid": "^13.0.0",
    "@unkey/api": "^2.3.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.28.5",
    "@orpc/zod": "^1.13.0",
    "@posthog/cli": "^0.5.29",
    "@types/bun": "latest",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^11.0.0",
    "@userplane/eslint-config": "*",
    "@userplane/typescript-config": "*",
    "eslint": "^9.32.0"
  },
  "exports": {
    "./routes": "./src/routes/index.ts",
    "./routes/api.router": "./src/routes/api.router.ts"
  },
  "name": "@userplane/api",
  "private": true,
  "scripts": {
    "build": "bun build src/index.ts --outdir ./dist --target bun --external inngest --sourcemap=linked && if [ -n \"$POSTHOG_PERSONAL_API_KEY\" ] && [ -n \"$POSTHOG_PROJECT_ID\" ]; then POSTHOG_CLI_TOKEN=$POSTHOG_PERSONAL_API_KEY POSTHOG_CLI_ENV_ID=$POSTHOG_PROJECT_ID posthog-cli sourcemap inject --directory ./dist && POSTHOG_CLI_TOKEN=$POSTHOG_PERSONAL_API_KEY POSTHOG_CLI_ENV_ID=$POSTHOG_PROJECT_ID posthog-cli sourcemap upload --directory ./dist; else echo 'Skipping source map upload (POSTHOG_PERSONAL_API_KEY or POSTHOG_PROJECT_ID not set)'; fi",
    "dev": "bun run dev:api",
    "dev:api": "bun run --env-file=.env.development --watch src/index.ts",
    "dev:inngest": "npx inngest-cli@latest dev",
    "dev:hot": "bun run --env-file=.env.development --hot src/index.ts",
    "start": "bun run dist/index.js",
    "start:production": "bun run --env-file=.env.production dist/index.js",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "version": "0.0.1"
}

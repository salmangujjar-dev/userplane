{
  "dependencies": {
    "@hono/zod-openapi": "^1.1.5",
    "@hono/zod-validator": "^0.4.1",
    "@orpc/openapi": "^1.12.3",
    "@orpc/server": "^1.12.3",
    "@sentry/bun": "^10.37.0",
    "@trigger.dev/sdk": "4.3.1",
    "@workspace/auth": "workspace:*",
    "@workspace/cache": "workspace:*",
    "@workspace/contract": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/email": "workspace:*",
    "@workspace/logger": "workspace:*",
    "@workspace/meta": "workspace:*",
    "@workspace/payments": "workspace:*",
    "@workspace/pricing": "workspace:*",
    "@workspace/shared": "workspace:*",
    "@workspace/storage": "workspace:*",
    "hono": "^4.6.16",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.1.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "slugify": "^1.6.6",
    "stoker": "^2.0.1",
    "uuid": "^13.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@orpc/zod": "^1.13.0",
    "@types/bun": "latest",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^11.0.0",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "concurrently": "^9.2.1",
    "eslint": "^9.32.0"
  },
  "exports": {
    "./routes": "./src/routes/index.ts",
    "./routes/api.router": "./src/routes/api.router.ts"
  },
  "name": "@workspace/api",
  "private": true,
  "scripts": {
    "build": "bun build src/index.ts --outdir ./dist --target bun",
    "dev": "bun run --watch src/index.ts",
    "dev:all": "concurrently \"bun run dev:api\" \"bun run dev:trigger\" --names \"api,trigger\" --prefix-colors \"blue,yellow\"",
    "dev:api": "bun run --watch src/index.ts",
    "dev:trigger": "npx trigger.dev@latest dev",
    "dev:hot": "bun run --hot src/index.ts",
    "start": "bun run dist/index.js",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "version": "0.0.1"
}

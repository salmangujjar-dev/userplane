# API Server Configuration
# Copy this file to .env.local and fill in the values

# ==========================================
# Server Configuration
# ==========================================
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Note: Clients will connect to this server at http://localhost:3001
# Make sure to set PUBLIC_API_URL / NEXT_PUBLIC_API_URL in client apps

# ==========================================
# CORS Configuration
# ==========================================
# Comma-separated list of allowed origins
# Add all your frontend URLs here
CORS_ORIGINS=http://localhost:3000,http://localhost:4321,http://localhost:4322
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400

# ==========================================
# Auth Configuration
# ==========================================
# -- Better Auth --
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-auth-secret-change-in-production
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_COOKIE_PREFIX=userplane

# -- Google OAuth --
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/callback/google

# -- Admin Configuration --
# Comma-separated list of user IDs that should be treated as global admins
# These users can impersonate other users and access admin features
ADMIN_USER_IDS=k00yzHXMtDvSMb8Tci9fyeYoexVTf9pI


# ==========================================
# Repository Configuration
# ==========================================
# Database
DATABASE_URL=postgresql://user:password@localhost:5432/userplane

# Storage Configuration (Cloudflare R2)
# Profile: development | staging | production
# In development, all bucket types use the dev bucket with prefixes
# In staging/production, each bucket type uses its own bucket
STORAGE_PROFILE=development

# Public domain for serving assets (CDN)
# This is the domain that will be used to serve the assets
# This can be cloudlfare r2 domain prefixed
# with cloudflare images domain or directly the r2 domain
ASSETS_DOMAIN=

# Development bucket (used for all storage in development profile)
R2_DEV_ACCOUNT_ID=
R2_DEV_ACCESS_KEY_ID=
R2_DEV_SECRET_ACCESS_KEY=
R2_DEV_BUCKET_NAME=

# CDN bucket (staging/production only)
R2_CDN_ACCOUNT_ID=
R2_CDN_ACCESS_KEY_ID=
R2_CDN_SECRET_ACCESS_KEY=
R2_CDN_BUCKET_NAME=

# Assets bucket (staging/production only)
R2_ASSETS_ACCOUNT_ID=
R2_ASSETS_ACCESS_KEY_ID=
R2_ASSETS_SECRET_ACCESS_KEY=
R2_ASSETS_BUCKET_NAME=

# Reports bucket (staging/production only)
R2_REPORTS_ACCOUNT_ID=
R2_REPORTS_ACCESS_KEY_ID=
R2_REPORTS_SECRET_ACCESS_KEY=
R2_REPORTS_BUCKET_NAME=


# ===========================================
# Email Configuration
# ===========================================
EMAIL_PROVIDER=localhost  # Options: localhost, resend
EMAIL_PROVIDER_API_KEY=           # Required when EMAIL_PROVIDER is not localhost

# Email Inboxes - Configure sender addresses for different email types
EMAIL_ONBOARDING_INBOX=onboarding@userplane.io
EMAIL_NOTIFICATION_INBOX=notifications@userplane.io
EMAIL_BILLING_INBOX=billing@userplane.io
EMAIL_INVITE_INBOX=invites@userplane.io
EMAIL_AUTH_INBOX=auth@userplane.io

# ==========================================
# JWT Configuration
# ==========================================
# default is userplane
JWT_ISSUER=userplane



# ==========================================
# Invite Configuration
# ==========================================

# Invite Token Configuration
# Generate with: openssl rand -base64 32
INVITE_TOKEN_SECRET=super-secret-invite-token

# Invite Token Expiration (in seconds)
# Default is 2592000 seconds (30 days)
INVITE_TOKEN_EXPIRES_IN=2592000

# Domain Verification Token Expiration (in seconds)
# Default is 300 seconds (5 minutes)
DOMAIN_VERIFICATION_TOKEN_EXPIRES_IN=300

# Access Request Token Expiration (in seconds)
# Default is 604800 seconds (7 days)
ACCESS_REQUEST_TOKEN_EXPIRES_IN=604800

# Workspace Create Invite Token Expiration (in seconds)
# Default is 604800 seconds (7 days)
WORKSPACE_CREATE_INVITE_TOKEN_EXPIRES_IN=604800

# Billing Email Verification Token Expiration (in seconds)
# Default is 600 seconds (10 minutes)
BILLING_EMAIL_VERIFICATION_TOKEN_EXPIRES_IN=600

# Invite App URL
# Default is http://localhost:3000
INVITE_APP_URL=http://localhost:3000

# ==========================================
# Session Configuration
# ==========================================

# Session Token Secret (for recording session initialization)
# Generate with: openssl rand -base64 32
SESSION_TOKEN_SECRET=dev-session-secret-change-in-production

# Upload Token Secret (for recording upload completion)
# Generate with: openssl rand -base64 32
UPLOAD_TOKEN_SECRET=dev-upload-secret-change-in-production

# Session Token Expiry (in seconds)
# Default is 10800 seconds (180 minutes)
SESSION_TOKEN_EXPIRY=10800

# Upload Token Expiry (in seconds)
# Default is 7200 seconds (120 minutes)
UPLOAD_TOKEN_EXPIRY=7200

# Presigned URL Expiry (in seconds)
# Default is 5400 seconds (90 minutes)
PRESIGNED_URL_EXPIRY=5400

# ==========================================
# Recorder Configuration
# ==========================================

# Recorder URL
# Default is http://localhost:4322
RECORDER_URL=http://localhost:4322

# Recorder Token Secret
# Generate with: openssl rand -base64 32
RECORDER_TOKEN_SECRET=dev-recorder-secret-change-in-production

# Recorder Token Expiration (in seconds)
# Default is 15552000 seconds (180 days)
RECORDER_TOKEN_EXPIRES_IN=15552000

# ===========================================
# Rate Limiting Configuration
# ===========================================
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# Trigger.dev Configuration
# ===========================================
# Get your secret key from: https://cloud.trigger.dev
# Navigate to your project > Settings > API Keys
TRIGGER_SECRET_KEY=

# Orphaned Workspace Sweep Configuration
# Number of days to look back when searching for deleted workspaces with orphaned recordings
# Default is 7 days (queries workspaces deleted from day before yesterday through 7 days back)
# Filters on workspace deletedAt timestamp, not recording createdAt
# This creates a rolling window: day N-2 through day N-8
WORKSPACE_SWEEP_LOOKBACK_DAYS=7

# Cron schedule for the orphaned workspace sweep job
# Default is "0 0 * * *" (daily at midnight UTC)
# With rolling window approach, daily execution is safe and efficient
# Format: minute hour day month weekday
# Examples:
#   "0 0 * * *"   - Every day at midnight (recommended)
#   "0 2 * * *"   - Every day at 2am
#   "0 0 */3 * *" - Every 3 days at midnight (if you want less frequent runs)
WORKSPACE_SWEEP_CRON_SCHEDULE=0 0 * * *

# Orphaned Project Sweep Configuration
# Number of days to look back when searching for deleted projects with orphaned recordings
# Default is 3 days (queries projects deleted from day before yesterday through 3 days back)
# Filters on project deletedAt timestamp, not recording createdAt
# This creates a rolling window: day N-2 through day N-4
PROJECT_SWEEP_LOOKBACK_DAYS=3

# Cron schedule for the orphaned project sweep job
# Default is "0 0 * * *" (daily at midnight UTC)
# Format: minute hour day month weekday
# Examples:
#   "0 0 * * *"   - Every day at midnight
#   "0 1 * * *"   - Every day at 1am
#   "0 0 * * 1"   - Every Monday at midnight
PROJECT_SWEEP_CRON_SCHEDULE=0 0 * * *

# Orphaned Recording Sweep Configuration
# Number of days to look back when searching for deleted recordings from active entities
# Default is 3 days (queries recordings deleted from day before yesterday through 3 days back)
# Filters recordings deleted from active (not deleted) workspaces and projects
# Filters on recording deletedAt timestamp
# This creates a rolling window: day N-2 through day N-4
RECORDING_SWEEP_LOOKBACK_DAYS=3

# Cron schedule for the orphaned recording sweep job
# Default is "0 0 * * *" (daily at midnight UTC)
# Format: minute hour day month weekday
# Examples:
#   "0 0 * * *"   - Every day at midnight
#   "0 1 * * *"   - Every day at 1am
#   "0 0 */2 * *" - Every 2 days at midnight
RECORDING_SWEEP_CRON_SCHEDULE=0 0 * * *

# ===========================================
# Restoration Configuration
# ===========================================
# Workspace Restoration Window
# Number of days after deletion during which a workspace can be restored
# Default is 2 days
# After this window expires, workspace cannot be restored
WORKSPACE_RESTORATION_WINDOW_DAYS=2

# Project Restoration Window
# Number of days after deletion during which a project can be restored
# Default is 2 days
# After this window expires, project cannot be restored
PROJECT_RESTORATION_WINDOW_DAYS=2

# API Server Configuration
# Copy this file to .env.local and fill in the values

# ==========================================
# Server Configuration
# ==========================================
PORT='3001'
HOST='0.0.0.0'
NODE_ENV='development'

# Application environment for deployment stage
# Controls behavior like cookie security, feature flags
# Separate from NODE_ENV which controls Node.js runtime optimizations
# Values: development | production
# - development: Development via Cloudflare tunnels (HTTPS, secure cookies)
# - production: Production server (HTTPS, secure cookies)
APP_ENV='development'

# Note: Clients will connect to this server via tunnel at https://api-dev.userplane.io
# Make sure to set PUBLIC_API_URL / NEXT_PUBLIC_API_URL in client apps

# ==========================================
# CORS Configuration
# ==========================================
# Comma-separated list of allowed origins
# Add all your frontend URLs here
# For Chrome extension: add chrome-extension://<extension-id> (get ID from chrome://extensions)
CORS_ORIGINS='https://dash-dev.userplane.io,https://home-dev.userplane.io,https://recorder-dev.userplane.io'
CORS_CREDENTIALS='true'
CORS_MAX_AGE='86400'

# ==========================================
# Auth Configuration
# ==========================================
# -- Better Auth --
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET='dev-auth-secret-change-in-production'
BETTER_AUTH_URL='https://api-dev.userplane.io'
BETTER_AUTH_COOKIE_PREFIX='userplane'
# Cookie domain for cross-subdomain sharing
# Set to share cookies across subdomains (both development and production)
# Example: .userplane.io (note the leading dot for all subdomains)
#
# Security: This controls which domains can READ the cookie, not which can USE it.
# Access control is enforced by trustedOrigins (CORS_ORIGINS) - requests from
# domains not in trustedOrigins are rejected even if they have the cookie.
# BETTER_AUTH_COOKIE_DOMAIN=.userplane.io

# -- Google OAuth --
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=''
GOOGLE_CLIENT_SECRET=''
GOOGLE_REDIRECT_URI=https://api-dev.userplane.io/api/auth/callback/google

# -- Admin Configuration --
# Comma-separated list of user IDs that should be treated as global admins
# These users can impersonate other users and access admin features
ADMIN_USER_IDS=k00yzHXMtDvSMb8Tci9fyeYoexVTf9pI


# ==========================================
# Repository Configuration
# ==========================================
# Database
DATABASE_URL=postgresql://user:password@localhost:5432/userplane

# Storage Configuration (Cloudflare R2)
# Each bucket type uses its own credentials

# Public domain for serving assets (CDN)
# This is the domain that will be used to serve the assets
# This can be cloudlfare r2 domain prefixed
# with cloudflare images domain or directly the r2 domain
ASSETS_DOMAIN='https://assets-dev.userplane.io'

# CDN domain for media assets (logos, favicons, etc.)
CDN_DOMAIN='https://cdn-dev.userplane.io'

# Cloudflare zone for image transforms (e.g., 'userplane.io')
# Used to optimize images on-the-fly via Cloudflare's /cdn-cgi/image/ endpoint
CLOUDFLARE_IMAGE_ZONE='userplane.io'

# Set to 'true' to disable image transforms (serve original URLs)
# Useful for debugging or when Cloudflare transforms are not available
# SKIP_IMAGE_TRANSFORM=true

# CDN bucket
R2_CDN_ACCOUNT_ID=''
R2_CDN_ACCESS_KEY_ID=''
R2_CDN_SECRET_ACCESS_KEY=''
R2_CDN_BUCKET_NAME=''

# Assets bucket
R2_ASSETS_ACCOUNT_ID=''
R2_ASSETS_ACCESS_KEY_ID=''
R2_ASSETS_SECRET_ACCESS_KEY=''
R2_ASSETS_BUCKET_NAME=''

# Reports bucket
R2_REPORTS_ACCOUNT_ID=''
R2_REPORTS_ACCESS_KEY_ID=''
R2_REPORTS_SECRET_ACCESS_KEY=''
R2_REPORTS_BUCKET_NAME=''


# ===========================================
# Email Configuration
# ===========================================
EMAIL_PROVIDER='localhost'  # Options: localhost, resend
EMAIL_PROVIDER_API_KEY=           # Required when EMAIL_PROVIDER is not localhost

# Email Inboxes - Configure sender addresses for different email types
EMAIL_ONBOARDING_INBOX=onboarding@mail.userplane.io
EMAIL_NOTIFICATION_INBOX=notifications@mail.userplane.io
EMAIL_BILLING_INBOX=billing@mail.userplane.io
EMAIL_INVITE_INBOX=invites@mail.userplane.io
EMAIL_AUTH_INBOX=auth@mail.userplane.io

# ==========================================
# JWT Configuration
# ==========================================
# default is userplane
JWT_ISSUER=userplane



# ==========================================
# Invite Configuration
# ==========================================

# Invite Token Configuration
# Generate with: openssl rand -base64 32
INVITE_TOKEN_SECRET='super-secret-invite-token'

# Invite Token Expiration (in seconds)
# Default is 2592000 seconds (30 days)
INVITE_TOKEN_EXPIRES_IN='2592000'

# Domain Verification Token Secret
# Generate with: openssl rand -base64 32
DOMAIN_VERIFICATION_TOKEN_SECRET='dev-domain-verification-secret-change-in-production'

# Domain Verification Token Expiration (in seconds)
# Default is 300 seconds (5 minutes)
DOMAIN_VERIFICATION_TOKEN_EXPIRES_IN='300'

# Access Request Token Expiration (in seconds)
# Default is 604800 seconds (7 days)
ACCESS_REQUEST_TOKEN_EXPIRES_IN='604800'

# Workspace Create Invite Token Expiration (in seconds)
# Default is 604800 seconds (7 days)
WORKSPACE_CREATE_INVITE_TOKEN_EXPIRES_IN='604800'

# Invite App URL
# Default is http://localhost:3000
INVITE_APP_URL='https://dash-dev.userplane.io'

# ==========================================
# Session Configuration
# ==========================================

# Session Token Secret (for recording session initialization)
# Generate with: openssl rand -base64 32
SESSION_TOKEN_SECRET='dev-session-secret-change-in-production'

# Upload Token Secret (for recording upload completion)
# Generate with: openssl rand -base64 32
UPLOAD_TOKEN_SECRET='dev-upload-secret-change-in-production'

# Session Token Expiry (in seconds)
# Default is 10800 seconds (180 minutes)
SESSION_TOKEN_EXPIRY='10800'

# Upload Token Expiry (in seconds)
# Default is 7200 seconds (120 minutes)
UPLOAD_TOKEN_EXPIRY='7200'

# Presigned URL Expiry (in seconds)
# Default is 5400 seconds (90 minutes)
PRESIGNED_URL_EXPIRY='5400'

# ==========================================
# Recorder Configuration
# ==========================================

# Recorder URL
# Default is http://localhost:4322
RECORDER_URL='https://recorder-dev.userplane.io'

# Recorder Token Secret
# Generate with: openssl rand -base64 32
RECORDER_TOKEN_SECRET='dev-recorder-secret-change-in-production'

# Recorder Token Expiration (in seconds)
# Default is 15552000 seconds (180 days)
RECORDER_TOKEN_EXPIRES_IN='15552000'

# ==========================================
# Share Configuration
# ==========================================

# Share Token Secret
# Generate with: openssl rand -base64 32
SHARE_TOKEN_SECRET='dev-share-secret-change-in-production'

# Share Token Expiration (in seconds)
# Default is 86400 seconds (24 hours)
SHARE_TOKEN_EXPIRES_IN='86400'

# Share Token Max Expiration (in seconds)
# Default is 1209600 seconds (14 days)
SHARE_TOKEN_MAX_EXPIRES_IN='1209600'

# ===========================================
# DodoPayments Configuration (Billing)
# ===========================================
# Get your API key from: https://app.dodopayments.com/
# Navigate to Developer > API section
DODO_PAYMENTS_API_KEY=''

# Webhook secret for signature verification
# Create a webhook in the DodoPayments dashboard pointing to your webhook URL
# Default endpoint: /api/auth/dodopayments/webhooks
DODO_PAYMENTS_WEBHOOK_SECRET=''

# Environment: test_mode or live_mode
DODO_PAYMENTS_ENVIRONMENT='test_mode'

# Product IDs (create these in DodoPayments dashboard)
# Format: pdt_xxxxxxxxxxxx
DODO_PRODUCT_ESSENTIAL_MONTHLY=''
DODO_PRODUCT_ESSENTIAL_ANNUAL=''
DODO_PRODUCT_STARTER_MONTHLY=''
DODO_PRODUCT_STARTER_ANNUAL=''
DODO_PRODUCT_SCALE_UP_MONTHLY=''
DODO_PRODUCT_SCALE_UP_ANNUAL=''
DODO_PRODUCT_ENTERPRISE_MONTHLY=''
DODO_PRODUCT_ENTERPRISE_ANNUAL=''

# Add-on IDs (create these in DodoPayments dashboard)
# Format: adn_xxxxxxxxxxxx
DODO_ADD_ON_SSO_ANNUAL=''
DODO_ADD_ON_SSO_MONTHLY=''
DODO_ADD_ON_SEATS_ANNUAL=''
DODO_ADD_ON_SEATS_MONTHLY=''

# ===========================================
# Rate Limiting Configuration
# ===========================================
RATE_LIMIT_WINDOW='60000'
RATE_LIMIT_MAX_REQUESTS='100'

# ===========================================
# Inngest Configuration
# ===========================================
# Optional in development (Inngest dev server doesn't require keys)
# Required in production: https://www.inngest.com/docs/sdk/serve#signing-key
# The INNGEST_EVENT_KEY is used for sending events and invoking functions
INNGEST_EVENT_KEY=''
# The INNGEST_SIGNING_KEY is used for authenticating requests between Inngest and your app
INNGEST_SIGNING_KEY=''

# Orphaned Workspace Sweep Configuration
# Number of days to look back when searching for deleted workspaces with orphaned recordings
# Default is 7 days (queries workspaces deleted from day before yesterday through 7 days back)
# Filters on workspace deletedAt timestamp, not recording createdAt
# This creates a rolling window: day N-2 through day N-8
WORKSPACE_SWEEP_LOOKBACK_DAYS='7'

# Cron schedule for the orphaned workspace sweep job
# Default is "0 0 * * *" (daily at midnight UTC)
# With rolling window approach, daily execution is safe and efficient
# Format: minute hour day month weekday
# Examples:
#   "0 0 * * *"   - Every day at midnight (recommended)
#   "0 2 * * *"   - Every day at 2am
#   "0 0 */3 * *" - Every 3 days at midnight (if you want less frequent runs)
WORKSPACE_SWEEP_CRON_SCHEDULE='0 0 * * *'

# Orphaned Project Sweep Configuration
# Number of days to look back when searching for deleted projects with orphaned recordings
# Default is 3 days (queries projects deleted from day before yesterday through 3 days back)
# Filters on project deletedAt timestamp, not recording createdAt
# This creates a rolling window: day N-2 through day N-4
PROJECT_SWEEP_LOOKBACK_DAYS='3'

# Cron schedule for the orphaned project sweep job
# Default is "0 0 * * *" (daily at midnight UTC)
# Format: minute hour day month weekday
# Examples:
#   "0 0 * * *"   - Every day at midnight
#   "0 1 * * *"   - Every day at 1am
#   "0 0 * * 1"   - Every Monday at midnight
PROJECT_SWEEP_CRON_SCHEDULE='0 0 * * *'

# Orphaned Recording Sweep Configuration
# Number of days to look back when searching for deleted recordings from active entities
# Default is 3 days (queries recordings deleted from day before yesterday through 3 days back)
# Filters recordings deleted from active (not deleted) workspaces and projects
# Filters on recording deletedAt timestamp
# This creates a rolling window: day N-2 through day N-4
RECORDING_SWEEP_LOOKBACK_DAYS='3'

# Cron schedule for the orphaned recording sweep job
# Default is "0 0 * * *" (daily at midnight UTC)
# Format: minute hour day month weekday
# Examples:
#   "0 0 * * *"   - Every day at midnight
#   "0 1 * * *"   - Every day at 1am
#   "0 0 */2 * *" - Every 2 days at midnight
RECORDING_SWEEP_CRON_SCHEDULE='0 0 * * *'

# Expired Recording Sweep Configuration
# Cron schedule for sweeping recordings whose share tokens have expired
# Default is "0 2 * * *" (daily at 2 AM UTC)
EXPIRED_RECORDING_SWEEP_CRON_SCHEDULE='0 2 * * *'

# ===========================================
# Restoration Configuration
# ===========================================
# Workspace Restoration Window
# Number of days after deletion during which a workspace can be restored
# Default is 2 days
# After this window expires, workspace cannot be restored
WORKSPACE_RESTORATION_WINDOW_DAYS='2'

# Project Restoration Window
# Number of days after deletion during which a project can be restored
# Default is 2 days
# After this window expires, project cannot be restored
PROJECT_RESTORATION_WINDOW_DAYS='2'

# Restoration Grace Period
# Number of days after deletion during which full restoration is possible
# Default is 3 days
RESTORATION_GRACE_PERIOD_DAYS='3'

# Restoration Max Window
# Number of days after deletion during which partial restoration is possible
# Default is 30 days
RESTORATION_MAX_WINDOW_DAYS='30'

# ===========================================
# Support Configuration
# ===========================================
# Documentation URL
DOCS_URL='https://userplane.io/docs'

# Support email address
SUPPORT_EMAIL='support@userplane.io'

# Calendar URL for booking intro calls
CALENDAR_URL='https://cal.com/userplane/sync'

# ===========================================
# Cache Configuration
# ===========================================
CACHE_ENABLED='false'
RATE_LIMIT_ENABLED='true'
UPSTASH_REDIS_REST_URL=''
UPSTASH_REDIS_REST_TOKEN=''

# ===========================================
# Intercom Configuration
# ===========================================
INTERCOM_REDIRECT_URI='https://dash-dev.userplane.io/callback/intercom'
INTERCOM_CLIENT_SECRET=''
INTERCOM_CLIENT_ID=''

# ===========================================
# Zendesk Configuration
# ===========================================
# OAuth credentials for calling Zendesk APIs.
# Register an OAuth client at:
# https://{subdomain}.zendesk.com/admin/apps-integrations/apis/apis/oauth_clients
# Scopes: read tickets:write apps:write
ZENDESK_CLIENT_ID=''
ZENDESK_CLIENT_SECRET=''
ZENDESK_REDIRECT_URI='https://dash-dev.userplane.io/callback/zendesk'

# Shared secret for Zendesk App JWT auth (HS256)
# Pushed to the Zendesk app installation during the connect flow via setInstallationSettings.
# Must match the jwt_secret stored on the Zendesk installation.
# Generate with: openssl rand -hex 32
ZENDESK_JWT_SECRET=''

# ===========================================
# PostHog Configuration (Error Monitoring)
# ===========================================
# PostHog is used for error tracking and product analytics.
# Project API key (phc_...), not a personal API key (phx_...)
# Get it from: https://us.posthog.com/settings/project

POSTHOG_PROJECT_API_KEY=''
POSTHOG_HOST='https://us.i.posthog.com'

# Personal API key (phx_...) for local feature flag evaluation
# Used by posthog-node to poll /api/feature_flags/local_evaluation
# Get it from: https://us.posthog.com/settings/user-api-keys
POSTHOG_FEATURE_FLAGS_KEY=''

# Personal API key for source map uploads (phx_...)
# Used by @posthog/cli during build to upload source maps
# Get it from: https://us.posthog.com/settings/user-api-keys
POSTHOG_PERSONAL_API_KEY=''

# PostHog project ID (numeric) for source map uploads
# Used by @posthog/cli during build to identify the target project
POSTHOG_PROJECT_ID=''

# ─── Billing ──────────────────────────────────────────────────
# Trial period in days for paid plan checkouts (default: 7)
TRIAL_PERIOD_DAYS=''

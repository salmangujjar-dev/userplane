# Server Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:4321,http://localhost:4322
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400

# Better Auth
BETTER_AUTH_SECRET=dev-auth-secret-change-in-production
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_COOKIE_PREFIX=userplane

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/callback/google

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/userplane

# Email Configuration
EMAIL_PROVIDER=localhost  # Options: localhost, resend
RESEND_API_KEY=           # Required when EMAIL_PROVIDER=resend

# Rate Limiting
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX_REQUESTS=100

# Default Store Configuration
# Used for automatic workspace store provisioning
DEFAULT_STORE_PROVIDER=r2                                          # Options: r2, s3
DEFAULT_STORE_URL=https://account.r2.cloudflarestorage.com       # Storage provider endpoint URL
DEFAULT_STORE_REGION=auto                                         # Storage region (use 'auto' for R2)
DEFAULT_STORE_BUCKET=your-bucket-name                             # Bucket name
DEFAULT_STORE_ACCESS_ID=your-access-id                            # Access key ID / Account ID
DEFAULT_STORE_ACCESS_KEY=your-secret-access-key                   # Secret access key

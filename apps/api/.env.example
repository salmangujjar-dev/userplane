# Server Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:4321,http://localhost:4322
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400

# Better Auth
BETTER_AUTH_SECRET=dev-auth-secret-change-in-production
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_COOKIE_PREFIX=userplane

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/callback/google

# Invite Token Configuration
INVITE_TOKEN_SECRET=dev-invite-secret-change-in-production
INVITE_APP_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/userplane

# Email Configuration
EMAIL_PROVIDER=localhost  # Options: localhost, resend
EMAIL_PROVIDER_API_KEY=           # Required when EMAIL_PROVIDER is not localhost

# Email Inboxes - Configure sender addresses for different email types
EMAIL_ONBOARDING_INBOX=onboarding@userplane.io
EMAIL_NOTIFICATION_INBOX=notifications@userplane.io
EMAIL_BILLING_INBOX=billing@userplane.io
EMAIL_INVITE_INBOX=invites@userplane.io

# Rate Limiting
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX_REQUESTS=100

{
  "name": "ramp",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "USERPLANE_SDK_SOURCE=workspace next dev --turbopack -p 3002",
    "build": "USERPLANE_SDK_SOURCE=npm next build",
    "build:production": "APP_ENV=production USERPLANE_SDK_SOURCE=npm next build",
    "start": "USERPLANE_SDK_SOURCE=npm next start -p 3002",
    "start:production": "APP_ENV=production USERPLANE_SDK_SOURCE=npm next start -p 3002",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "npx tsx src/lib/db/migrate.ts",
    "db:import-local": "npx tsx src/lib/db/import-local.ts",
    "db:seed": "npx tsx src/lib/db/seed.ts",
    "db:reset": "TURSO_ALLOW_SEED_RESET=1 npx tsx src/lib/db/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@base-ui/react": "^1.1.0",
    "@intercom/messenger-js-sdk": "^0.0.18",
    "@libsql/client": "^0.17.3",
    "@next/env": "16.1.6",
    "@userplane/common-logger": "*",
    "@userplane/sdk": "https://registry.npmjs.org/@userplane/sdk/-/sdk-0.0.6.tgz",
    "boring-avatars": "^2.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "nuqs": "^2.8.8",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "2.15.4",
    "swr": "^2.4.0",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@userplane/eslint-config": "*",
    "@userplane/typescript-config": "*",
    "eslint": "^9",
    "shadcn": "^3.8.4",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/

# Environment Variables
# Keep .env.example for reference
.env
.env.*
!.env.example
!.env.submit.example

# Testing
coverage/
*.coverage
.nyc_output/

# Turbo
.turbo/

# Vercel
.vercel/

# Cloudflare
.wrangler/

# Build Outputs
.next/
out/
build/
dist/
.astro/
.output/
.wxt/
.trigger/

# Zendesk manifest packaging output
*.zip

# Copied build artifacts
apps/recorder/public/bridge-worker.js
packages/postbridge/src/bridge-worker.js

# TypeScript build cache
*.tsbuildinfo

# TypeScript compiled files in dist directories
**/dist/**/*.js
**/dist/**/*.d.ts
**/dist/**/*.d.ts.map
**/.next/**/*.js
**/.next/**/*.d.ts
**/build/**/*.js
**/build/**/*.d.ts

# Debug & Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
bun-debug.log*
*.log

# IDEs
.idea/
.vscode/
*.swp
*.swo
*~

# OS Files
.DS_Store
Thumbs.db

# Certificates
*.pem
*.key
*.cert

# Cache
.cache/
.parcel-cache/
.eslintcache

# Temporary files
*.tmp
*.temp
dump/

# Cloudflare Tunnel runtime files (keep config.yml tracked)
.cloudflared/*.pid
.cloudflared/*.log

# Mocked stores
apps/api/localhost

# Cursor dumps
*.md

!README.md
!CLAUDE.md
!AGENTS.md
!CONTRIBUTING.md
!LICENSE
!LICENSES/

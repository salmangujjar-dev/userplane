{
  "name": "userplane",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --concurrency=30",
    "lint": "turbo lint",
    "lint:fix": "turbo lint -- --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,mdx,astro}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,mdx,astro}\"",
    "fix": "bun run lint:fix && bun run format",
    "check:env": "node scripts/check-env-vars.js",
    "prepare": "husky"
  },
  "devDependencies": {
    "@userplane/eslint-config": "*",
    "@userplane/typescript-config": "*",
    "drizzle-kit": "^0.31.9",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "3.8.2",
    "prettier-plugin-astro": "^0.14.1",
    "turbo": "^2.5.5",
    "typescript": "5.7.3"
  },
  "packageManager": "bun@1.3.3",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "lint-staged": {
    "*.{ts,tsx,js,jsx,astro,json,md,mdx,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@better-auth/oauth-provider": "^1.6.2",
    "better-auth": "^1.6.2",
    "drizzle-orm": "^0.45.1",
    "prism-react-renderer": "^2.4.1"
  },
  "overrides": {
    "@smithy/types": "4.12.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}

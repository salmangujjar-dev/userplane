{
  "name": "userplane",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --concurrency=30",
    "lint": "turbo lint",
    "lint:fix": "turbo lint -- --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,astro}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,astro}\"",
    "fix": "bun run lint:fix && bun run format",
    "check:env": "node scripts/check-env-vars.js",
    "prepare": "husky"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "turbo": "^2.5.5",
    "typescript": "5.7.3"
  },
  "packageManager": "bun@1.1.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "lint-staged": {
    "*.{ts,tsx,js,jsx,astro,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "prism-react-renderer": "^2.4.1"
  },
  "overrides": {
    "@smithy/types": "4.12.0"
  }
}
